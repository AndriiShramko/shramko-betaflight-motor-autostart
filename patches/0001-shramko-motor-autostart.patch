+    EXPECT_GE(beepCalls - beeps, 10);           // the buzzer goes on every 3 s
+    EXPECT_EQ(5, stateNow());
+}
+#endif
+
+// F13: the CLI accepts autostart_cell_cutoff 1..249 (docs: 0 or 250..420); 33 meant "3.3 V" but was 0.33 V/cell,
+// i.e. no protection. It is raised to 2.50 V/cell.
+TEST(AutostartFixTest, CellCutoffBelow250IsRaisedTo250)
+{
+    setDefaults(AUTOSTART_MODE_POWER);
+    autostartConfigMutable()->cellCutoffCv = 33;
+    debugMode = DEBUG_AUTOSTART;
+    autostartInit();
+    runUntil(25000);
+    ASSERT_EQ(1150.0f, motor_disarmed[0]);
+    fakeVbat = 1450;                            // 14.5 V = 2.42 V per cell on 6S: over-discharged
+    runUntil(31000);
+    EXPECT_EQ(DISARM, motor_disarmed[0]);
+    EXPECT_EQ(5, debug[0]);
+}
+
+// F13: the gust generator was seeded from millis() at the start, which is nearly the same on every battery
+// power-up, so the "random" gusts repeated on every boot. Now: micros() and the ADC noise at the first RUN tick.
+static std::vector<timeMs_t> gustEdges(uint16_t vbat, timeUs_t jitterUs)
+{
+    setDefaults(AUTOSTART_MODE_POWER);
+    autostartConfigMutable()->pattern = AUTOSTART_PATTERN_GUSTS;
+    debugMode = DEBUG_AUTOSTART;
+    fakeVbat = vbat;
+    fakeMicrosJitter = jitterUs;
+    autostartInit();
+    std::vector<timeMs_t> edges;
+    bool gust = false;
+    for (timeMs_t t = 1520; t < 80000; t += 20) {
+        runUntil(t);
+        if (((debug[4] & 16) != 0) != gust) {
+            gust = !gust;
+            edges.push_back(t);
+        }
+    }
+    return edges;
+}
+
+TEST(AutostartFixTest, GustSequenceDiffersBetweenPowerUps)
+{
+    const std::vector<timeMs_t> a = gustEdges(2500, 0);
+    EXPECT_GE(a.size(), 10u);
+    EXPECT_EQ(a, gustEdges(2500, 0));           // same inputs, same gusts (the test itself is deterministic)
+    EXPECT_NE(a, gustEdges(2503, 0));           // 30 mV of ADC noise: different gusts
+    EXPECT_NE(a, gustEdges(2500, 137));         // 137 us of scheduler jitter: different gusts
+}
