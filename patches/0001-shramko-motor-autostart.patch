+struct Results {
+    long violations[V_COUNT];
+    std::string first[V_COUNT];
+    long cover[C_COUNT];
+    Results() { memset(violations, 0, sizeof(violations)); memset(cover, 0, sizeof(cover)); }
+    long total(void) const { long t = 0; for (int i = 0; i < V_COUNT; i++) t += violations[i]; return t; }
+};
+
+struct Prng {
+    uint32_t s;
+    explicit Prng(uint32_t seed) : s(seed ? seed : 0x2545F491u) {}
+    uint32_t next(void) { s ^= s << 13; s ^= s >> 17; s ^= s << 5; return s; }
+    uint32_t below(uint32_t n) { return n ? next() % n : 0; }
+    uint32_t range(uint32_t lo, uint32_t hi) { return hi <= lo ? lo : lo + below(hi - lo + 1); }
+    bool chance(uint32_t per100k) { return per100k && below(100000) < per100k; }
+    // an edge value of [lo, hi] (1 in 4), anywhere in [lo, hi] (1 in 8), else a typical value
+    uint32_t edge(uint32_t lo, uint32_t hi, uint32_t typLo, uint32_t typHi)
+    {
+        switch (below(8)) {
+        case 0: return lo;
+        case 1: return hi;
+        case 2: return range(lo, hi);
+        default: return range(typLo, typHi);
+        }
+    }
+};
+
+// autostart_cell_cutoff as the module uses it: 1..249 is raised to 250 (docs: 0 or 250..420)
+static uint32_t cutoffCvPerCell(uint16_t cellCutoffCv)
+{
+    return cellCutoffCv ? MAX(cellCutoffCv, (uint16_t)250) : 0;
+}
