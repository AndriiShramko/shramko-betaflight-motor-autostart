+
+#include "platform.h"
+
+#ifdef USE_AUTOSTART
+
+#include "drivers/io.h"
+
+#include "pg/pg_ids.h"
+
+#include "autostart.h"
+
+// Generic default is OFF so that a build that merely compiles this file never spins a motor.
+// The project board config (config.h) sets AUTOSTART_DEFAULT_MODE AUTOSTART_MODE_POWER.
+#ifndef AUTOSTART_DEFAULT_MODE
+#define AUTOSTART_DEFAULT_MODE AUTOSTART_MODE_OFF
+#endif
+#ifndef AUTOSTART_DEFAULT_DELAY_S
+#define AUTOSTART_DEFAULT_DELAY_S 10
+#endif
+#ifndef AUTOSTART_DEFAULT_RAMP_DS
+#define AUTOSTART_DEFAULT_RAMP_DS 100           // 10.0 s
+#endif
+#ifndef AUTOSTART_DEFAULT_THROTTLE_PCT
+#define AUTOSTART_DEFAULT_THROTTLE_PCT 15
+#endif
+#ifndef AUTOSTART_DEFAULT_MOTOR_MASK
+#define AUTOSTART_DEFAULT_MOTOR_MASK 0x01       // motor 1 only
+#endif
+#ifndef AUTOSTART_DEFAULT_USB_INHIBIT
+#define AUTOSTART_DEFAULT_USB_INHIBIT 1
+#endif
+#ifndef AUTOSTART_DEFAULT_RC_BOX
+#define AUTOSTART_DEFAULT_RC_BOX 255            // PERMANENT_ID_NONE
+#endif
+#ifndef AUTOSTART_DEFAULT_VBAT_MIN_DV
+#define AUTOSTART_DEFAULT_VBAT_MIN_DV 60        // 6.0 V: any 2S+ battery, never the USB 5 V back-feed
+#endif
+#ifndef AUTOSTART_DEFAULT_RUN_TIME_S
+#define AUTOSTART_DEFAULT_RUN_TIME_S 0          // run until the battery cut-off / power off
+#endif
+#ifndef AUTOSTART_DEFAULT_THROTTLE_LIMIT
+#define AUTOSTART_DEFAULT_THROTTLE_LIMIT 100
+#endif
+#ifndef AUTOSTART_DEFAULT_PATTERN
+#define AUTOSTART_DEFAULT_PATTERN AUTOSTART_PATTERN_STEADY
+#endif
+#ifndef AUTOSTART_DEFAULT_CELLS
+#define AUTOSTART_DEFAULT_CELLS 0               // auto-detect
+#endif
+#ifndef AUTOSTART_DEFAULT_CELL_CUTOFF_CV
+#define AUTOSTART_DEFAULT_CELL_CUTOFF_CV 330    // 3.30 V per cell
+#endif
+#ifndef AUTOSTART_DEFAULT_CUTOFF_TIME_S
+#define AUTOSTART_DEFAULT_CUTOFF_TIME_S 5
+#endif
+#ifndef AUTOSTART_BUTTON_PIN
+#define AUTOSTART_BUTTON_PIN NONE
+#endif
+
+PG_REGISTER_WITH_RESET_TEMPLATE(autostartConfig_t, autostartConfig, PG_AUTOSTART_CONFIG, 0);
+
+PG_RESET_TEMPLATE(autostartConfig_t, autostartConfig,
+    .mode = AUTOSTART_DEFAULT_MODE,
+    .delaySeconds = AUTOSTART_DEFAULT_DELAY_S,
+    .rampDeciseconds = AUTOSTART_DEFAULT_RAMP_DS,
+    .throttlePercent = AUTOSTART_DEFAULT_THROTTLE_PCT,
+    .motorMask = AUTOSTART_DEFAULT_MOTOR_MASK,
+    .usbInhibit = AUTOSTART_DEFAULT_USB_INHIBIT,
+    .rcBoxPermanentId = AUTOSTART_DEFAULT_RC_BOX,
+    .buttonTag = IO_TAG(AUTOSTART_BUTTON_PIN),
+    .vbatMinDeciVolts = AUTOSTART_DEFAULT_VBAT_MIN_DV,
+    .runTimeSeconds = AUTOSTART_DEFAULT_RUN_TIME_S,
+    .gustLenMinMs = 300,
+    .gustLenMaxMs = 800,
+    .gustPauseMinDs = 20,
+    .gustPauseMaxDs = 80,
+    .cellCutoffCv = AUTOSTART_DEFAULT_CELL_CUTOFF_CV,
+    .throttleLimit = AUTOSTART_DEFAULT_THROTTLE_LIMIT,
+    .pattern = AUTOSTART_DEFAULT_PATTERN,
+    .gustMinPercent = 40,
+    .gustMaxPercent = 80,
+    .cells = AUTOSTART_DEFAULT_CELLS,
+    .cutoffTimeSeconds = AUTOSTART_DEFAULT_CUTOFF_TIME_S,
+);
+
+#endif // USE_AUTOSTART
