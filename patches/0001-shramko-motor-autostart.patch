+            char row[200];
+            snprintf(row, sizeof(row), "  %llu %u %d %d %d %d %.0f %.0f %.0f %.0f %u %u %d %d %d %d %d %d\n", (unsigned long long)tr.t,
+                (unsigned)tr.ms, tr.s, tr.src, tr.flags, tr.d, tr.m[0], tr.m[1], tr.m[2], tr.m[3], tr.vbat, tr.vf, tr.batt, tr.usb,
+                tr.rx, tr.pressed, tr.cli, tr.held);
+            s += row;
+        }
+        res.first[v] = s;
+    }
+
+    // ---------------------------------------------------------------- settings and world
+    void randomConfig(autostartConfig_t *c, bool withWorld)
+    {
+        memset(c, 0, sizeof(*c));
+        const uint32_t m = r.below(20);
+        c->mode = m == 0 ? AUTOSTART_MODE_OFF : (m <= 11 ? AUTOSTART_MODE_POWER : AUTOSTART_MODE_BUTTON);
+        c->delaySeconds = r.edge(0, 600, 0, 12);
+        c->rampDeciseconds = r.edge(0, 6000, 0, 150);
+        c->throttlePercent = r.edge(0, 100, 1, 100);
+        c->throttleLimit = r.edge(1, 100, 1, 100);
+        static const uint8_t masks[] = { 0x01, 0x01, 0x03, 0x05, 0x0F, 0xF0, 0x10, 0x81, 0xFF, 0x0D };
+        c->motorMask = r.below(4) == 0 ? (uint8_t)r.edge(1, 255, 1, 255) : masks[r.below(sizeof(masks))];
+        c->usbInhibit = r.below(2);
+        static const uint8_t boxes[] = { 255, 255, 42, 42, 42, 0, 40, 43 };
+        c->rcBoxPermanentId = r.below(8) == 0 ? (uint8_t)r.range(0, 255) : boxes[r.below(sizeof(boxes))];
+        c->buttonTag = (c->mode == AUTOSTART_MODE_BUTTON) ? (r.below(100) < 85) : (r.below(100) < 30);
+        c->runTimeSeconds = r.below(10) < 4 ? 0 : r.edge(0, 65535, 1, 90);
+        c->pattern = r.below(2);
+        c->gustMinPercent = r.edge(0, 100, 0, 100);
+        c->gustMaxPercent = r.edge(0, 100, 0, 100);
+        c->gustLenMinMs = r.edge(50, 10000, 50, 1500);
+        c->gustLenMaxMs = r.edge(50, 10000, 50, 1500);
+        c->gustPauseMinDs = r.edge(0, 6000, 0, 80);
+        c->gustPauseMaxDs = r.edge(0, 6000, 0, 80);
+        c->cells = r.edge(0, 12, 0, 12);
+        c->cellCutoffCv = r.below(5) == 0 ? 0 : r.edge(0, 420, 250, 420);
+        c->cutoffTimeSeconds = r.edge(1, 60, 1, 10);
+        if (!withWorld) {
+            c->vbatMinDeciVolts = r.edge(0, 600, 30, 200);
+            return;
+        }
+        // battery and vbat_min together, so that most sequences can see the battery
+        physCells = (c->cells && r.below(10) < 8) ? c->cells : (uint8_t)r.range(1, 12);
+        packCv = physCells * r.range(300, 435);
+        const uint32_t v = r.below(20);
+        if (v < 2) {
+            c->vbatMinDeciVolts = 0;
+        } else if (v < 9) {
+            c->vbatMinDeciVolts = 60;
+        } else if (v < 15) {
+            c->vbatMinDeciVolts = r.range(1, MAX(packCv / 10, 1));
+        } else {
+            c->vbatMinDeciVolts = r.edge(0, 600, 30, 200);
+        }
+        autoCells = (c->cells == 0) ? (r.below(5) == 0 ? 0 : physCells) : (uint8_t)r.range(0, 12);
+    }
+
+    uint16_t gateCv(void) const { return autostartConfig()->vbatMinDeciVolts * 10; }
+
+    void startBoot(void)
+    {
+        booting = true;
+        taskOn = false;
+        bootTrue = now;
+        initAt = now + 20 * r.range(50, 100);       // init 1.0 .. 2.0 s after power-on
+        cli = false;
+        armed = false;
+        res.cover[C_BOOTS]++;
+    }
+
+    void finishBoot(void)
+    {
+        booting = false;
+        fakeMs = millisNow();
+        for (int i = 0; i < MAX_SUPPORTED_MOTORS; i++) {
+            motor_disarmed[i] = DISARM;                 // MCU reset, mixer init
+            autoOwned[i] = false;
+            envWroteWhileDriving[i] = false;
+        }
+        cliMode = false;
+        armingFlags = 0;
+        pinFree = r.below(10) != 0;
+        fakePinFree = pinFree;
+        fakeCells = autoCells;
+        fakePinHigh = !pressed;
+        spikeFirstRead = false;
+        tickReadIndex = 1;
+#ifdef USE_DSHOT
+        fakeMotorEnableMs = fakeMs;     // motorEnable() at the end of init, right before autostartInit()
+        dshotFirstPassed = false;
+#ifdef USE_DSHOT_TELEMETRY
+        // derived from the time, not from r: keeps the random stream (and the coverage) of the sequences as it was
+        edtOn = ((now / 20) % 2) != 0;
+        motorConfigMutable()->dev.useDshotEdt = edtOn;
+#endif
+#endif
+        oNoBatteryTicks = 0;
+        edtThisBattery = 0;
+        fakeMicrosJitter = (timeUs_t)((now * 7919u) % 20000u);
+        autostartInit();
+        bootCfg = *autostartConfig();
+        taskOn = bootCfg.mode != AUTOSTART_MODE_OFF;      // tasksInit(): setTaskEnabled(TASK_AUTOSTART, autostartIsEnabled())
+        buttonUsable = taskOn && bootCfg.buttonTag && pinFree;
+        oFirst = true; oRaw = false; oConfirmed = false; oAtFirstA = oAtFirstB = false; oRawChange = now;
+        oDetect = oDetectEarly = 0; oSince = 0; firstCheck = now; battAtFirstCheck = batt; unplugSinceFirstCheck = false;
+        held = false; lowLatched = false; doneLatched = false; rxEver = false; pendingPossible = false;
+        lastInhibit = now; boxOnRun = false;
+        prevS = ST_IDLE; prevSrc = SRC_NONE; progEver = false; oLow = oLowE = false;
+        pressHist = 0; spikeHist = 0; ticksSinceInit = 0;
+        wroteThisBoot = false; cutMismatch = false; rxSeenSure = false; mRxWasValid = false; mRxSince = 0;
+        note("boot: autostartInit, task %s, pin %s", taskOn ? "on" : "off", pinFree ? "free" : "taken");
+        // boot-time biases: the battery connector bouncing around the first check, an ADC spike at the first check
+        if (usb && batt && bootCfg.vbatMinDeciVolts && r.below(8) == 0) {
+            unplugAt = now + 20 * r.range(1, 14);
+            replugAt = unplugAt + 20 * r.range(30, 1000);
+        }
+        if (usb && !batt && bootCfg.vbatMinDeciVolts && r.below(12) == 0) {
+            glitchUntil = now + 20 * r.range(1, 13);
+            glitchCv = gateCv() + r.range(0, 800);
+            lastUpGlitch = now;
+            note("ADC spike at the first check: %u cV", glitchCv);
+        }
+    }
+
+    void plugBattery(void)
+    {
+        batt = true;
+        battPlug = now;
+        riseMs = r.range(0, 1500);
+        replugAt = 0;
+        glitchUntil = 0;
+        note("battery plugged (%u cV)", packCv);
+    }
+
+    void unplugBattery(uint64_t forMs)
+    {
+        batt = false;
+        battUnplug = now;
+        unplugSinceFirstCheck = true;
+        glitchUntil = 0;
+        sagUntil = 0;
+        replugAt = forMs ? now + forMs : 0;
+        res.cover[C_UNPLUGS]++;
+        note("battery unplugged (back in %llu ms)", (unsigned long long)forMs);
+    }
+
+    void envWrite(int i, float v, const char *who)
+    {
+        if (motor_disarmed[i] != v) {
+            if (autostartIsDrivingMotors() && i < kMotorCount && progEver && (progMask & (1U << i))) {
+                envWroteWhileDriving[i] = true;
+                if (strcmp(who, "msp") != 0) {
+                    held = true;                        // outputsOverwritten() sees it on the next tick
+                    res.cover[C_FOREIGN_DETECTED]++;
+                }
+            }
+        }
+        motor_disarmed[i] = v;
+        autoOwned[i] = false;
+    }
+
+    float randomMotorValue(void) { return r.below(3) == 0 ? DISARM : (float)r.range(1000, 2000); }
+
+    // autostartComputerTookOver() runs outside the 50 Hz task: it may only put the program's own motors to stop
+    void computerHook(void)
+    {
+        float m[MAX_SUPPORTED_MOTORS];
+        for (int i = 0; i < MAX_SUPPORTED_MOTORS; i++) {
+            m[i] = motor_disarmed[i];
+        }
+        autostartComputerTookOver();
+        bool released = false;
+        for (int i = 0; i < MAX_SUPPORTED_MOTORS; i++) {
+            if (motor_disarmed[i] != m[i]) {
+                released = true;
+                const bool ours = progEver && i < kMotorCount && (progMask & (1U << i));
+                if (!ours || motor_disarmed[i] != DISARM || envWroteWhileDriving[i]) {
+                    fail(V_HOOK_WRITE, "hook: motor %d %.0f -> %.0f (program mask 0x%02X, other writer %d)", i, m[i],
+                        motor_disarmed[i], progMask, envWroteWhileDriving[i]);
+                }
+            }
+        }
+        if (autostartIsDrivingMotors()) {
+            fail(V_HOOK_WRITE, "still driving right after the hook");
+        }
+        res.cover[C_HOOK_STOPS] += released;
+    }
+
+    bool quiescent(void) const
+    {
+        if (!boardOn || booting || !taskOn || cli || armed || pressed || spikeRate || pendingPossible || lowLatched) {
+            return false;
+        }
+        if (now < sagUntil || now < glitchUntil || now < rxGlitchUntil || now < pressUntil || replugAt || unplugAt || pressAt || depleteAt) {
+            return false;
+        }
+        if (now - rxChange < 600 || now - oRawChange < 600 || now - buttonChange < 200) {     // every debounce settled
+            return false;
+        }
+        if (now - bootTrue < 3100 || (oConfirmed && now - oDetect < 3100) || now - lastInhibit < 600) {   // uptime, ESC 3 s, RX confirmation reached
+            return false;
+        }
+        if (prevS == ST_IDLE || prevS == ST_DONE) {
+            return true;
+        }
+        if (prevS == ST_RUN && prog.pattern == AUTOSTART_PATTERN_STEADY && prog.runTimeSeconds == 0 && !oLow) {
+            const uint8_t cells = autostartConfig()->cells ? autostartConfig()->cells : autoCells;
+            const uint32_t cutoff = cutoffCvPerCell(prog.cellCutoffCv) * cells;
+            return cutoff == 0 || packCv >= cutoff + 50;
+        }
+        return false;
+    }
+
+    void warp(void)
+    {
+        const uint32_t ms = millisNow();
+        const uint32_t kind = r.below(3);
+        uint32_t target;
+        if (kind == 0) {
+            target = 0x80000000u - 20 * r.range(0, 3000);
+        } else if (kind == 1) {
+            target = (uint32_t)(0x100000000ull - 20ull * r.range(1, 3000));
+        } else {
+            target = ms + 20 * r.range(180000, 43200000);   // 1 h .. 10 days
+        }
+        uint32_t delta = target - ms;
+        delta -= delta % 20;
+        if (delta < 1000) {
+            return;
+        }
+        now += delta;
+        endAt += delta;
+        res.cover[kind == 0 ? C_WARP_2_31 : (kind == 1 ? C_WARP_2_32 : C_WARP_LONG)]++;
+        note("time warp +%u ms (inputs stable, module quiescent)", (unsigned)delta);
+        // then provoke what depends on time: a click, a depleted battery, a re-plug around the wrap
+        if (kind == 0) {
+            const uint64_t past = now + (0x80000000u - millisNow()) + 20 * r.range(0, 1000);
+            if (buttonUsable) {
+                pressAt = past;
+            }
+            if (r.below(2)) {
+                depleteAt = past + 20 * r.range(0, 1000);
+            }
+        } else if (kind == 1 && usb && bootCfg.vbatMinDeciVolts && batt) {
+            const uint64_t wrapAt = now + (uint64_t)(0x100000000ull - millisNow());
+            if (wrapAt > now + 2000) {
+                unplugAt = wrapAt - 20 * r.range(50, 90);
+                replugAt = wrapAt + 20 * r.range(0, 120);
+            }
+        }
+    }
+
+    void randomEvents(void)
+    {
+        // scheduled
+        if (pressUntil && now >= pressUntil) {
+            pressed = false;
+            pressUntil = 0;
+            buttonChange = now;
+            note("button released");
+        }
+        if (pressAt && now >= pressAt) {
+            pressAt = 0;
+            pressed = true;
+            buttonChange = now;
+            pressUntil = now + 20 * r.range(4, 50);
+            note("button pressed (scheduled)");
+        }
+        if (rxGlitchUntil && now >= rxGlitchUntil) {
+            rxGlitchUntil = 0;
+            rx = false;
+            rxChange = now;
+            note("rx glitch end");
+        }
+        if (armedUntil && now >= armedUntil) {
+            armedUntil = 0;
+            armed = false;
+            note("disarmed");
+        }
+        if (f3dUntil && now >= f3dUntil) {
+            f3dUntil = 0;
+            f3d = false;
+            note("feature 3D off");
+        }
+        if (unplugAt && now >= unplugAt) {
+            unplugAt = 0;
+            if (batt) {
+                const uint64_t back = replugAt > now ? replugAt - now : 600;
+                unplugBattery(MAX(back, (uint64_t)600));
+            }
+        }
+        if (replugAt && now >= replugAt && !batt) {
+            plugBattery();
+        }
+        if (depleteAt && now >= depleteAt) {
+            depleteAt = 0;
+            const uint8_t cells = autostartConfig()->cells ? autostartConfig()->cells : autoCells;
+            const uint32_t cutoff = cutoffCvPerCell(autostartConfig()->cellCutoffCv) * cells;
+            if (cutoff > 300) {
+                packCv = (uint16_t)MAX(cutoff - r.range(1, 200), (uint32_t)gateCv() + 1);
+                note("battery depleted to %u cV (scheduled)", packCv);
+            }
+        }
+
+        const bool gate = autostartConfig()->vbatMinDeciVolts != 0;
+        // battery
+        if (gate && batt && r.chance(rate[EV_UNPLUG])) {
+            unplugBattery(r.below(3) ? 20 * r.range(30, 1500) : 0);
+        }
+        // a hand needs > 0.5 s to unplug and re-plug: shorter interruptions look like ADC glitches to any detector
+        if (gate && !batt && !replugAt && now - lastUpGlitch > 1000 && now - battUnplug >= 600 && r.chance(rate[EV_PLUG])) {
+            plugBattery();
+        }
+        if (batt && now >= glitchUntil && r.chance(rate[EV_GLITCH_DOWN])) {
+            glitchUntil = now + 20 * r.range(1, 24);
+            glitchCv = gate ? (uint16_t)r.range(0, gateCv() - 1) : 0;
+            res.cover[C_GLITCHES]++;
+            note("ADC glitch low %u cV for %llu ms", glitchCv, (unsigned long long)(glitchUntil - now));
+        }
+        if (gate && !batt && now >= glitchUntil && now - battUnplug > 1000 && (!replugAt || replugAt > now + 1500)
+            && r.chance(rate[EV_GLITCH_UP])) {
+            glitchUntil = now + 20 * r.range(1, 14);
+            glitchCv = gateCv() + r.range(0, 800);
+            lastUpGlitch = now;
+            res.cover[C_GLITCHES]++;
+            note("ADC glitch high %u cV for %llu ms", glitchCv, (unsigned long long)(glitchUntil - now));
+        }
+        if (batt && now >= sagUntil && r.chance(rate[EV_SAG])) {
+            const uint8_t cells = autostartConfig()->cells ? autostartConfig()->cells : autoCells;
+            const uint32_t cutoff = cutoffCvPerCell(autostartConfig()->cellCutoffCv) * cells;
+            const uint32_t lo = cutoff > 300 ? cutoff - 300 : 0;
+            sagCv = (uint16_t)MIN(r.range(lo, cutoff + 100), (uint32_t)packCv);
+            sagUntil = now + 20 * r.range(5, (MAX(autostartConfig()->cutoffTimeSeconds, 1) * 1000 + 3000) / 20);
+            res.cover[C_SAGS]++;
+            note("sag to %u cV for %llu ms", sagCv, (unsigned long long)(sagUntil - now));
+        }
+        if (batt && r.chance(rate[EV_DEPLETE])) {
+            const uint8_t cells = autostartConfig()->cells ? autostartConfig()->cells : autoCells;
+            const uint32_t cutoff = cutoffCvPerCell(autostartConfig()->cellCutoffCv) * cells;
+            if (cutoff > 200) {
+                packCv = (uint16_t)MAX(cutoff - r.range(1, 200), (uint32_t)gateCv());
+                note("battery depleted to %u cV", packCv);
+            }
+        }
+        if (batt && r.chance(rate[EV_RECOVER])) {
+            packCv = (uint16_t)MIN(packCv + r.range(20, 150), 5300u);
+            note("battery recovers to %u cV", packCv);
+        }
+        if (r.chance(rate[EV_USB])) {
+            usb = !usb;
+            note("USB %s", usb ? "connected" : "disconnected");
+        }
+        // receiver
+        if (!rxGlitchUntil && r.chance(rate[EV_RX])) {
+            rx = !rx;
+            rxChange = now;
+            res.cover[C_RX_LINKS] += rx;
+            note("rx link %s", rx ? "valid" : "lost");
+        }
+        if (!rx && r.chance(rate[EV_RX_GLITCH])) {
+            rx = true;
+            rxChange = now;
+            rxGlitchUntil = now + 20 * r.range(1, 24);
+            note("rx glitch valid for %llu ms", (unsigned long long)(rxGlitchUntil - now));
+        }
+        if (r.chance(rate[EV_BOX])) {
+            static const int boxes[] = { BOXID_NONE, BOXUSER3, BOXUSER3, BOXARM, BOXUSER1 };
+            box = boxes[r.below(5)];
+            note("RC switch -> box %d", box);
+        }
+        // button
+        if (!pressed && r.chance(rate[EV_PRESS])) {
+            pressed = true;
+            buttonChange = now;
+            pressUntil = now + 20 * r.range(4, 100);
+            note("button pressed for %llu ms", (unsigned long long)(pressUntil - now));
+        }
+        if (!pressed && r.chance(rate[EV_BOUNCE])) {
+            pressed = true;
+            buttonChange = now;
+            pressUntil = now + 20 * r.range(1, 2);
+            note("button bounce %llu ms", (unsigned long long)(pressUntil - now));
+        }
+        if (r.chance(rate[EV_SPIKES])) {
+            static const uint32_t rates[] = { 0, 0, 300, 1000 };
+            spikeRate = rates[r.below(4)];
+            note("EMI spikes on the button pin: %u / 1000 ticks", (unsigned)spikeRate);
+        }
+        // computer
+        if (boardOn && !booting && !cli && r.chance(rate[EV_CLI_ENTER])) {
+            cli = true;
+            res.cover[C_CLI_SESSIONS]++;
+            note("CLI entered");
+            if (r.below(3) == 0) {          // pasted together with the entry: processed before the next autostart tick
+                cliMotorCommand();
+            }
+            if (r.below(3) == 0) {
+                cliSetCommand();
+            }
+        }
+        if (cli && r.chance(rate[EV_CLI_MOTOR])) {
+            cliMotorCommand();
+        }
+        if (cli && r.chance(rate[EV_CLI_MOTOR])) {
+            cliSetCommand();
+        }
+        if (cli && r.chance(rate[EV_CLI_EXIT])) {
+            cli = false;
+            for (int i = 0; i < MAX_SUPPORTED_MOTORS; i++) {
+                envWrite(i, DISARM, "cliexit");     // mixerResetDisarmedMotors()
+            }
+            const uint32_t how = r.below(3);
+            if (how == 0) {
+                note("CLI exit noreboot");
+            } else {
+                if (how == 1) {
+                    stored = *autostartConfig();
+                    note("CLI save (reboot)");
+                } else {
+                    *autostartConfigMutable() = stored;
+                    note("CLI exit (reboot, unsaved changes lost)");
+                }
+                res.cover[C_SW_REBOOTS]++;
+                startBoot();
+            }
+        }
+        if (boardOn && !booting && r.chance(rate[EV_MSP])) {
+            const bool stop = r.below(2);
+            computerHook();                         // msp.c calls the hook first, then writes the motors
+            for (int i = 0; i < kMotorCount; i++) {
+                envWrite(i, stop ? DISARM : randomMotorValue(), "msp");
+            }
+            held = true;
+            res.cover[C_MSP_WRITES]++;
+            note("MSP_SET_MOTOR %s", stop ? "STOP" : "values");
+        }
+        if (boardOn && !booting && r.chance(rate[EV_FOREIGN])) {
+            const int i = r.below(MAX_SUPPORTED_MOTORS);
+            const float v = randomMotorValue();
+            note("foreign write motor %d = %.0f", i, v);
+            envWrite(i, v, "foreign");
+        }
+        if (!armed && r.chance(rate[EV_ARM])) {
+            armed = true;
+            armedUntil = now + 20 * r.range(1, 500);
+            res.cover[C_ARMS]++;
+            note("armed");
+        }
+        if (!f3d && r.chance(rate[EV_3D])) {
+            f3d = true;
+            f3dUntil = now + 20 * r.range(1, 1000);
+            res.cover[C_F3D]++;
+            note("feature 3D on");
+        }
+        if (boardOn && !booting && r.chance(rate[EV_REBOOT])) {
+            *autostartConfigMutable() = stored;
+            res.cover[C_SW_REBOOTS]++;
+            note("reboot (MSP_SET_REBOOT / Restart program)");
+            startBoot();
+        }
+        if (warps < 2 && quiescent() && r.chance(rate[EV_WARP])) {
+            warps++;
+            warp();
+        }
+    }
+
+    void cliMotorCommand(void)
+    {
+        const float v = (float)r.range(1000, 2000);
+        if (r.below(3) == 0) {
+            for (int i = 0; i < kMotorCount; i++) {
+                envWrite(i, v, "cli");
+            }
+            note("CLI motor 255 %.0f", v);
+        } else {
+            const int i = r.below(kMotorCount);
+            envWrite(i, v, "cli");
+            note("CLI motor %d %.0f", i, v);
+        }
+    }
+
+    void cliSetCommand(void)
+    {
+        autostartConfig_t c;
+        randomConfig(&c, false);
+        autostartConfig_t *live = autostartConfigMutable();
+        switch (r.below(6)) {
+        case 0: live->mode = c.mode; break;
+        case 1: live->throttlePercent = c.throttlePercent; live->throttleLimit = c.throttleLimit; break;
+        case 2: live->motorMask = c.motorMask; break;
+        case 3: live->usbInhibit = c.usbInhibit; break;
+        case 4: live->delaySeconds = c.delaySeconds; live->rampDeciseconds = c.rampDeciseconds; break;
+        default: live->cellCutoffCv = c.cellCutoffCv; live->cells = c.cells; break;
+        }
+        note("CLI set: %s", configText(*live).c_str());
+    }
+
+    void powerTransitions(void)
+    {
+        const bool on = usb || batt;
+        if (boardOn && !on) {
+            boardOn = false;
+            booting = false;
+            taskOn = false;
+            cli = false;
+            res.cover[C_POWER_CYCLES]++;
+            note("board off");
+        } else if (!boardOn && on) {
+            boardOn = true;
+            *autostartConfigMutable() = stored;
+            note("board on");
+            startBoot();
+        }
+    }
+
+    // ---------------------------------------------------------------- module inputs
+    void setInputs(void)
+    {
+        uint16_t reading;
+        if (batt) {
+            reading = packCv;
+            if (now < sagUntil) {
+                reading = MIN(reading, sagCv);
+            }
+        } else {
+            reading = backfeed;
+        }
+        const bool glitch = now < glitchUntil;
+        if (glitch) {
+            reading = glitchCv;
+        }
+        // getBatteryVoltage(): filtered; rises for riseMs after the battery appears, ignores short glitches
+        uint16_t filtered;
+        if (batt) {
+            const uint64_t ref = MAX(battPlug, bootTrue);
+            const uint16_t base = (now < sagUntil) ? MIN(packCv, sagCv) : packCv;
+            if (riseMs && now - ref < riseMs) {
+                filtered = (uint16_t)((uint32_t)base * (uint32_t)(now - ref) / riseMs);
+            } else {
+                filtered = base;
+            }
+            if (glitch) {
+                filtered = lastFiltered;
+            }
+        } else {
+            filtered = reading;
+        }
+        lastFiltered = filtered;
+        fakeVbat = reading;
+        fakeVbatFiltered = filtered ? filtered : (reading ? 1 : 0);
+        fakeUsb = usb;
+        fakeRxValid = rx;
+        fakeActiveBox = (boxId_e)box;
+        fakeFeatures = f3d ? FEATURE_3D : 0;
+        if (armed) {
+            ENABLE_ARMING_FLAG(ARMED);
+        } else {
+            DISABLE_ARMING_FLAG(ARMED);
+        }
+        cliMode = cli;
+        fakePinHigh = !pressed;
+        spikeNow = spikeRate && r.below(1000) < spikeRate;
+        spikeFirstRead = spikeNow;
+        tickReadIndex = 0;
+        fakeMs = millisNow();
+        debugMode = DEBUG_AUTOSTART;
+    }
+
+    bool boxActive(void) const { return bootCfg.rcBoxPermanentId == 42 && box == BOXUSER3; }
+
+    // ---------------------------------------------------------------- one tick of the module + the oracle
+    void tick(void)
+    {
+        for (int i = 0; i < MAX_SUPPORTED_MOTORS; i++) {
+            before[i] = motor_disarmed[i];
+        }
+#ifdef USE_DSHOT
+        edtRequestsBefore = edtRequests;
+        edtAcceptedBefore = edtAccepted;
+#endif
+        autostartUpdate((timeUs_t)fakeMs * 1000);
+        res.cover[C_TICKS]++;
+        if (millisNow() >= 0x80000000u) {
+            res.cover[C_TICKS_PAST_2_31]++;
+        }
+        if (now - bootTrue >= 0x100000000ull) {
+            res.cover[C_TICKS_AFTER_WRAP]++;
+        }
+        check();
+    }
+
+    void check(void)
+    {
+        const int S = debug[0], src = debug[7], flags = debug[4];
+        const bool D = autostartIsDrivingMotors();
+        const autostartConfig_t *live = autostartConfig();
+        const uint64_t uptime = now - bootTrue;
+
+        TraceRow &tr = trace[traceN];
+        traceN = (traceN + 1) % 12;
+        tr.t = now; tr.ms = millisNow(); tr.s = S; tr.src = src; tr.flags = flags; tr.d = D;
+        for (int i = 0; i < kMotorCount; i++) {
+            tr.m[i] = motor_disarmed[i];
+        }
+        tr.vbat = fakeVbat; tr.vf = fakeVbatFiltered; tr.batt = batt; tr.usb = usb; tr.rx = rx; tr.pressed = pressed; tr.cli = cli;
+
+        // ---- mirror of the battery detection (300 ms to confirm, 500 ms to lose; with a USB host 2 ticks below 1 V)
+        // docs: plugged in at >= vbat_min; once seen, it stays "there" down to min(vbat_min, cells x 2.50 V)
+        uint32_t rawThreshold = live->vbatMinDeciVolts * 10u;
+        if (oRaw) {
+            const uint32_t floorCv = (uint32_t)(live->cells ? live->cells : autoCells) * 250u;
+            if (floorCv && floorCv < rawThreshold) {
+                rawThreshold = floorCv;
+            }
+        }
+        const bool rawOk = live->vbatMinDeciVolts == 0 || fakeVbat >= rawThreshold;
+        oNoBatteryTicks = fakeVbat < 100 ? oNoBatteryTicks + 1 : 0;
+        if (oFirst) {
+            oFirst = false;
+            oAtFirstA = oAtFirstB = rawOk;
+        }
+        if (rawOk != oRaw) {
+            oRaw = rawOk;
+            oRawChange = now;
+            if (!rawOk) {
+                oAtFirstB = false;
+            }
+        }
+        justConfirmed = justLost = false;
+        if (!oConfirmed && oRaw && now - oRawChange >= 300) {
+            oConfirmed = true;
+            justConfirmed = true;
+            oDetect = oAtFirstB ? bootTrue : oRawChange;                    // latest legitimate reference
+            const bool bootLegit = oAtFirstA && battAtFirstCheck && !unplugSinceFirstCheck;
+            oDetectEarly = bootLegit ? bootTrue : oDetect;                  // earliest legitimate reference
+            oAtFirstA = oAtFirstB = false;
+            oSince = (oRawChange - bootTrue <= 2500) ? bootTrue : oRawChange;
+        } else if (oConfirmed && !oRaw && (now - oRawChange >= 500 || (usb && oNoBatteryTicks >= 2))) {
+            oConfirmed = false;
+            justLost = true;
+            edtThisBattery = 0;
+            res.cover[C_USB_FAST_LOSS] += now - oRawChange < 500;
+        }
+        if (oConfirmed && live->vbatMinDeciVolts && fakeVbat < live->vbatMinDeciVolts * 10u) {
+            res.cover[C_SAG_HYSTERESIS]++;      // below vbat_min, still "there" (load sag)
+        }
+#ifdef USE_DSHOT
+        // ---- extended DShot telemetry: once per battery, 3 s after it appeared, never into the stock gate
+        if (edtRequests != edtRequestsBefore) {
+            if (!edtOn || !oConfirmed || uptime < 3000 || now - oDetectEarly < 3000 || edtThisBattery > 0) {
+                fail(V_EDT_REQUEST, "EDT asked: dshot_edt %d, battery %d, %llu ms after it appeared, uptime %llu ms, %d earlier",
+                    edtOn, oConfirmed, (unsigned long long)(now - oDetectEarly), (unsigned long long)uptime, edtThisBattery);
+            }
+            if (edtAccepted == edtAcceptedBefore) {
+                fail(V_EDT_DROPPED, "EDT asked %llu ms after motorEnable(): the stock gate dropped it",
+                    (unsigned long long)(millisNow() - fakeMotorEnableMs));
+            }
+            edtThisBattery++;
+            res.cover[C_EDT_ASKED]++;
+        }
+#endif
+
+        const bool inhibit = cli || armed || f3d || (live->usbInhibit && usb);
+        if (!inhibit) {
+            if (rx && !mRxWasValid) {
+                mRxSince = now;
+            }
+            mRxWasValid = rx;
+        }
+        const bool rxConfirmed = !inhibit && rx && now - mRxSince >= 500;
+        if (inhibit) {
+            lastInhibit = now;
+        }
+        if (cli) {
+            held = true;
+        }
+        tr.held = held;
+        if (rx) {
+            rxEver = true;
+        }
+        const bool boxOn = rx && boxActive();
+        if (boxOn && !boxOnRun) {
+            boxOnSince = now;
+        }
+        boxOnRun = boxOn;
+
+        // button mirror: bit 0 = this tick
+        ticksSinceInit++;
+        pressHist = (pressHist << 1) | (pressed ? 1 : 0);
+        spikeHist = (spikeHist << 1) | ((spikeNow && !pressed) ? 1 : 0);
+        // a click needs 4 pressed samples (60 ms debounce from the first one), also right after noise
+        // (finding P8, focused test ButtonDebounceAfterNoiseIsShort)
+        const bool longPress = buttonUsable && (pressHist & 0xF) == 0xF;
+        const bool cleanClick = buttonUsable && (pressHist & 0xFF) == 0x0F && (spikeHist & 0xF0) == 0 && ticksSinceInit >= 10;
+
+        // ---- latches
+        if (justLost) {
+            lowLatched = false;
+            doneLatched = false;
+        }
+        if (pressed || !boxOn) {
+            doneLatched = false;            // a user action (click) or the switch was released
+        }
+
+        const bool started = isActive(S) && !isActive(prevS);
+        const bool stopped = isActive(prevS) && !isActive(S);
+
+        // ---- outputs: who wrote what
+        for (int i = 0; i < MAX_SUPPORTED_MOTORS; i++) {
+            if (motor_disarmed[i] != before[i]) {
+                const float v = motor_disarmed[i];
+                if (!progEver || i >= kMotorCount || !(progMask & (1U << i))) {
+                    fail(V_WRITE_OUTSIDE_MASK, "motor %d changed %.0f -> %.0f, program mask 0x%02X", i, before[i], v, progMask);
+                }
+                if (!(v == DISARM || (v >= 1001.0f && v <= 1000.0f + 10.0f * progLimit))) {
+                    fail(V_WRITE_OUT_OF_RANGE, "motor %d = %.0f, limit %u %%", i, v, progLimit);
+                }
+                if (envWroteWhileDriving[i]) {
+                    fail(V_STOMPED_OTHER_WRITER, "motor %d: %.0f (written by another writer) -> %.0f", i, before[i], v);
+                }
+                autoOwned[i] = true;
+            }
+        }
+        if (!D) {
+            for (int i = 0; i < kMotorCount; i++) {
+                if (progEver && (progMask & (1U << i)) && autoOwned[i] && motor_disarmed[i] > DISARM) {
+                    fail(V_LEFT_MOTOR_RUNNING, "not driving (state %d) but motor %d still at %.0f written by the program", S, i, motor_disarmed[i]);
+                    autoOwned[i] = false;       // report once per motor
+                }
+            }
+            if (debug[1] != 0 && wroteThisBoot) {    // module statics survive autostartInit() here, a real boot zeroes them
+                fail(V_DEBUG_PERCENT_STOPPED, "debug[1] = %d while not driving (state %d)", debug[1], S);
+            }
+        }
+
+        // ---- never drive while ...
+        if (D) {
+            wroteThisBoot = true;
+            if (cli) fail(V_DRIVE_IN_CLI, "driving in CLI mode");
+            if (armed) fail(V_DRIVE_WHILE_ARMED, "driving while armed");
+            if (f3d) fail(V_DRIVE_WITH_3D, "driving with feature 3D");
+            if (live->usbInhibit && usb) fail(V_DRIVE_WITH_USB_INHIBIT, "driving with USB and usb_inhibit");
+            if (held) fail(V_DRIVE_WHILE_HELD, "driving while held by the computer");
+            if (!oConfirmed) fail(V_DRIVE_WITHOUT_BATTERY, "driving, battery not confirmed");
+            if (!batt && now - battUnplug >= 520) fail(V_DRIVE_AFTER_UNPLUG, "driving %llu ms after the battery was removed", (unsigned long long)(now - battUnplug));
+            // a battery plugged in before the first check counts from boot (the module cannot see earlier)
+            const uint64_t appeared = (battPlug <= firstCheck) ? bootTrue : battPlug;
+            if (batt && (now - appeared < 3000 || uptime < 3000)) {
+                fail(V_DRIVE_BEFORE_ESC_3S, "driving %llu ms after the battery appeared (uptime %llu ms): the ESC had < 3 s of stop frames",
+                    (unsigned long long)(now - appeared), (unsigned long long)uptime);
+            }
+            if (S != ST_RAMP && S != ST_RUN) fail(V_DRIVE_IN_WRONG_STATE, "driving in state %d", S);
+        }
+        if (S == ST_RUN && !D) {
+            fail(V_RUN_WITHOUT_OUTPUT, "state RUN but nothing written");
+        }
+        if (((flags & 64) != 0) != held) {
+            fail(V_HELD_FLAG, "debug held bit %d, oracle held %d", (flags & 64) != 0, held);
+        }
+        if (((flags & 8) != 0) != oConfirmed) {
+            fail(V_BATTERY_FLAG, "debug battery bit %d, oracle %d", (flags & 8) != 0, oConfirmed);
+        }
+
+        // ---- receiver link
+        if (rxConfirmed && !boxActive() && (D || isActive(S))) {
+            fail(V_RX_LINK_DID_NOT_STOP, "link valid for %llu ms, switch off, state %d", (unsigned long long)(now - mRxSince), S);
+        }
+        if (!rx && isActive(S) && src == SRC_RCBOX) {
+            fail(V_RCBOX_PROGRAM_NO_LINK, "state %d owned by the RC switch without a link", S);
+        }
+        if (boxOn && now - boxOnSince >= 600 && now - lastInhibit >= 600 && !held && oConfirmed && now - oRawChange >= 600
+            && !isActive(S) && S != ST_DONE && S != ST_LOWBAT) {
+            fail(V_RCBOX_DID_NOT_START, "link + switch for %llu ms, state %d", (unsigned long long)(now - boxOnSince), S);
+        }
+
+        // ---- starts
+        if (started) {
+            if (!oConfirmed || held || inhibit) {
+                fail(V_START_WHILE_FORBIDDEN, "start (source %d) with battery=%d held=%d inhibit=%d", src, oConfirmed, held, inhibit);
+            }
+            switch (src) {
+            case SRC_POWER:
+                res.cover[C_START_POWER]++;
+                if (!(pendingPossible || (justConfirmed && live->mode == AUTOSTART_MODE_POWER))) {
+                    fail(V_POWER_START_UNEXPECTED, "power start without a battery plug-in");
+                }
+                break;
+            case SRC_BUTTON:
+                res.cover[C_START_BUTTON]++;
+                if (!longPress || rx) {
+                    fail(V_BUTTON_START_NO_CLICK, "button start, press history 0x%X, rx %d", (unsigned)(pressHist & 0xFF), rx);
+                }
+                break;
+            case SRC_RCBOX:
+                res.cover[C_START_RCBOX]++;
+                if (!boxOn || !rxConfirmed) {
+                    fail(V_RCBOX_START_NO_SWITCH, "RC start: switch %d, link valid for %llu ms", boxOn, rx ? (unsigned long long)(now - mRxSince) : 0ull);
+                }
+                break;
+            default:
+                fail(V_START_UNKNOWN_SOURCE, "start with source %d", src);
+                break;
+            }
+            if (prevS == ST_LOWBAT && lowLatched) {
+                fail(V_RESTART_AFTER_LOWBAT, "LOW_BATTERY -> state %d (source %d) without a battery re-plug", S, src);
+            }
+            if (prevS == ST_DONE && doneLatched) {
+                fail(V_RESTART_AFTER_RUN_TIME, "DONE -> state %d (source %d) without a user action", S, src);
+            }
+            prog = *live;
+            progEver = true;
+            progMask = prog.motorMask;
+            progLimit = (uint8_t)constrain(prog.throttleLimit, 1, 100);
+            progThr = MIN(prog.throttlePercent, progLimit);
+            progStart = now;
+            const uint64_t ref = (src == SRC_POWER) ? oSince : now;
+            expectedRamp = MAX(MAX(ref + prog.delaySeconds * 1000ull, oDetect + 3000), MAX(bootTrue + 3000, now));
+            expectedRampEarly = MAX(MAX(ref + prog.delaySeconds * 1000ull, oDetectEarly + 3000), MAX(bootTrue + 3000, now));
+            oLow = oLowE = false;
+            cutMismatch = false;
+            for (int i = 0; i < MAX_SUPPORTED_MOTORS; i++) {
+                envWroteWhileDriving[i] = false;
+            }
+        }
+        if (justConfirmed && live->mode == AUTOSTART_MODE_POWER && !rxEver && !inhibit && !held && !rx && !(pressHist & 0xF)) {
+            if (!(started && src == SRC_POWER)) {
+                fail(V_POWER_START_MISSING, "battery confirmed in POWER mode, state %d source %d", S, src);
+            }
+        }
+        if (cleanClick && !rx && !inhibit && prevSrc != SRC_RCBOX) {
+            res.cover[C_CLEAN_CLICKS]++;
+            if (isActive(prevS)) {
+                if (isActive(S)) {
+                    fail(V_CLICK_IGNORED, "click while running did not stop (state %d)", S);
+                }
+            } else if (prevS != ST_LOWBAT && oConfirmed && !held && !justLost) {
+                if (!(started && src == SRC_BUTTON)) {
+                    fail(V_CLICK_IGNORED, "click did not start (state %d -> %d)", prevS, S);
+                }
+            }
+        }
+        if (isActive(prevS) && isActive(S) && src != prevSrc && !(src == SRC_RCBOX && boxOn && rxConfirmed)) {
+            fail(V_SOURCE_CHANGE, "source %d -> %d mid-program", prevSrc, src);
+        }
+        if (stopped && S == ST_IDLE) {
+            const bool reason = inhibit || held || justLost || rxConfirmed || (prevSrc == SRC_RCBOX && !rx) || longPress;
+            if (!reason) {
+                fail(V_STOP_WITHOUT_REASON, "state %d -> IDLE without a reason", prevS);
+            }
+        }
+        pendingPossible = (pendingPossible || (justConfirmed && live->mode == AUTOSTART_MODE_POWER)) && !started && rx && !rxConfirmed
+            && !inhibit && !held && oConfirmed;
+
+        // ---- latch checks (state left without the event that may clear it)
+        if (lowLatched && S != ST_LOWBAT && !justLost) {
+            if (!started) {
+                fail(V_RESTART_AFTER_LOWBAT, "LOW_BATTERY -> state %d without a battery re-plug", S);
+            }
+            lowLatched = false;
+        }
+        if (doneLatched && S != ST_DONE && !started) {
+            doneLatched = false;
+        }
+
+        // ---- program timing and values
+        if (isActive(S)) {
+            if (S == ST_DELAY && now >= expectedRamp) {
+                fail(V_DELAY_OVERRUN, "still DELAY %llu ms after the expected ramp start (source %d)", (unsigned long long)(now - expectedRamp), src);
+            }
+            if (S == ST_RAMP && (prevS == ST_DELAY || started)) {
+                res.cover[C_RAMP_REACHED]++;
+                if (now < expectedRampEarly) {
+                    fail(V_RAMP_EARLY, "RAMP %llu ms before max(start + delay, ESC 3 s, uptime 3 s)", (unsigned long long)(expectedRampEarly - now));
+                }
+                rampStart = now;
+                lastRampOut = DISARM;
+            }
+            const uint64_t rampMs = prog.rampDeciseconds * 100ull;
+            const uint64_t expectedRun = rampStart + MAX(rampMs, (uint64_t)20);
+            int m0 = -1;
+            for (int i = 0; i < kMotorCount; i++) {
+                if (progMask & (1U << i)) {
+                    m0 = i;
+                    break;
+                }
+            }
+            if (S == ST_RAMP && !(prevS == ST_DELAY || started)) {
+                if (now >= expectedRun) {
+                    fail(V_RAMP_OVERRUN, "still RAMP %llu ms after its end", (unsigned long long)(now - expectedRun));
+                }
+                if (m0 >= 0 && rampMs > 0) {
+                    const timeDelta_t elapsed = (timeDelta_t)(now - rampStart);
+                    const float expect = outputFor((float)progThr * (float)elapsed / (float)rampMs, progLimit);
+                    for (int i = 0; i < kMotorCount; i++) {
+                        if ((progMask & (1U << i)) && fabsf(motor_disarmed[i] - expect) > 0.5f) {
+                            fail(V_RAMP_VALUE, "ramp at %d ms: motor %d = %.0f, expected %.0f", (int)elapsed, i, motor_disarmed[i], expect);
+                        }
+                    }
+                    if (motor_disarmed[m0] < lastRampOut) {
+                        fail(V_RAMP_DECREASING, "ramp %.0f -> %.0f", lastRampOut, motor_disarmed[m0]);
+                    }
+                    lastRampOut = motor_disarmed[m0];
+                }
+            }
+            if (S == ST_RUN && prevS == ST_RAMP) {
+                res.cover[C_RUN_REACHED]++;
+                if (now < expectedRun) {
+                    fail(V_RUN_EARLY, "RUN %llu ms before the end of the ramp", (unsigned long long)(expectedRun - now));
+                }
+                runStart = now;
+                gustFlag = false;
+                gustEdge = now;
+                if (m0 >= 0 && lastRampOut > outputFor(progThr, progLimit)) {
+                    fail(V_RAMP_DECREASING, "ramp ended above the steady level");
+                }
+            }
+            if (S == ST_RUN) {
+                if (prog.runTimeSeconds && now >= runStart + prog.runTimeSeconds * 1000ull) {
+                    fail(V_RUN_TIME_OVERRUN, "still RUN %llu ms after run_time", (unsigned long long)(now - runStart - prog.runTimeSeconds * 1000ull));
+                }
+                const float steady = outputFor(progThr, progLimit);
+                const bool g = (flags & 16) != 0;
+                if (g) {
+                    res.cover[C_GUSTS] += !gustFlag;
+                }
+                if (m0 >= 0) {
+                    const float v = motor_disarmed[m0];
+                    for (int i = 0; i < kMotorCount; i++) {
+                        if ((progMask & (1U << i)) && motor_disarmed[i] != v) {
+                            fail(V_RUN_VALUE, "masked motors differ: motor %d = %.0f, motor %d = %.0f", m0, v, i, motor_disarmed[i]);
+                        }
+                    }
+                    if (prog.pattern != AUTOSTART_PATTERN_GUSTS || !g) {
+                        if (v != steady) {
+                            fail(V_RUN_VALUE, "RUN %.0f, expected min(throttle %u, limit %u) = %.0f (gust flag %d)", v,
+                                prog.throttlePercent, progLimit, steady, g);
+                        }
+                    } else {
+                        // docs: bursts on top of the steady level, a peak below it is raised to it
+                        const int gLo = MAX((int)MIN(prog.gustMinPercent, prog.gustMaxPercent), (int)progThr);
+                        const int gHi = MAX((int)MAX(prog.gustMinPercent, prog.gustMaxPercent), gLo);
+                        const int q = (int)lrintf((v - 1000.0f) / 10.0f);
+                        if (fabsf(v - (1000.0f + 10.0f * q)) > 0.01f || q < MIN(gLo, (int)progLimit) || q > MIN(gHi, (int)progLimit)) {
+                            fail(V_GUST_VALUE, "gust peak %.0f outside %d..%d %% (limit %u)", v, gLo, gHi, progLimit);
+                        }
+                        if (gustFlag && v != gustValue) {
+                            fail(V_GUST_VALUE, "gust value changed %.0f -> %.0f within one gust", gustValue, v);
+                        }
+                        gustValue = v;
+                    }
+                }
+                if (prog.pattern == AUTOSTART_PATTERN_GUSTS && g != gustFlag && prevS == ST_RUN) {
+                    const uint64_t dur = now - gustEdge;
+                    if (g) {
+                        const uint64_t pLo = MAX((uint64_t)20, up20(MIN(prog.gustPauseMinDs, prog.gustPauseMaxDs) * 100ull));
+                        const uint64_t pHi = MAX((uint64_t)20, up20(MAX(prog.gustPauseMinDs, prog.gustPauseMaxDs) * 100ull));
+                        if (dur < pLo || dur > pHi) {
+                            fail(V_GUST_PAUSE, "pause %llu ms outside %llu..%llu", (unsigned long long)dur, (unsigned long long)pLo, (unsigned long long)pHi);
+                        }
+                    } else {
+                        const uint64_t lLo = up20(MIN(prog.gustLenMinMs, prog.gustLenMaxMs));
+                        const uint64_t lHi = up20(MAX(prog.gustLenMinMs, prog.gustLenMaxMs));
+                        if (dur < lLo || dur > lHi) {
+                            fail(V_GUST_LENGTH, "gust %llu ms outside %llu..%llu", (unsigned long long)dur, (unsigned long long)lLo, (unsigned long long)lHi);
+                        }
+                    }
+                    gustFlag = g;
+                    gustEdge = now;
+                } else if (prog.pattern == AUTOSTART_PATTERN_GUSTS && g != gustFlag) {
+                    fail(V_GUST_PAUSE, "gust flag set on the first RUN tick");
+                    gustFlag = g;
+                    gustEdge = now;
+                }
+            }
+        }
+        if (S == ST_DONE && prevS != ST_DONE) {
+            res.cover[C_DONE_REACHED]++;
+            if (prevS != ST_RUN || !prog.runTimeSeconds || now < runStart + prog.runTimeSeconds * 1000ull) {
+                fail(V_DONE_EARLY, "DONE from state %d after %llu ms of RUN (run_time %u s)", prevS, (unsigned long long)(now - runStart), prog.runTimeSeconds);
+            }
+            doneLatched = true;             // until a click, a re-plug, a reboot or the RC switch released
+        }
+
+        // ---- battery cut-off mirror
+        const bool cutNow = (S == ST_LOWBAT && prevS != ST_LOWBAT);
+        const bool activeAtCheck = isActive(S) || ((S == ST_LOWBAT || S == ST_DONE) && S != prevS && isActive(prevS));
+        if (activeAtCheck) {
+            const uint8_t cells = live->cells ? live->cells : autoCells;
+            const uint32_t cutoff = cutoffCvPerCell(prog.cellCutoffCv) * cells;
+            const uint16_t vf = fakeVbatFiltered ? fakeVbatFiltered : fakeVbat;
+            const uint64_t cutMs = MAX(prog.cutoffTimeSeconds, 1) * 1000ull;
+            const bool lowV = cutoff > 0 && vf >= 100 && vf < cutoff && oConfirmed && uptime >= 3000;
+            const bool lowCond = lowV && now - oDetect >= 3000;         // latest legitimate ESC reference
+            const bool lowCondE = lowV && now - oDetectEarly >= 3000;   // earliest
+            if (!lowCond) {
+                oLow = false;
+            } else if (!oLow) {
+                oLow = true;
+                oLowStart = now;
+            }
+            if (!lowCondE) {
+                oLowE = false;
+            } else if (!oLowE) {
+                oLowE = true;
+                oLowStartE = now;
+            }
+            const bool expectCut = oLow && now - oLowStart >= cutMs;            // must have cut by now
+            const bool mayCut = oLowE && now - oLowStartE >= cutMs;             // may cut from now on
+            if (expectCut && !cutNow && !cutMismatch) {
+                fail(V_CUTOFF_MISSED, "filtered %u cV < cut-off %u cV for %llu ms (cutoff_time %u s), state %d",
+                    vf, (unsigned)cutoff, (unsigned long long)(now - oLowStart), prog.cutoffTimeSeconds, S);
+                cutMismatch = true;         // no follow-up reports for this program
+            }
+            if (cutNow && !mayCut && !cutMismatch) {
+                fail(V_CUTOFF_EARLY, "LOW_BATTERY with filtered %u cV, cut-off %u cV, low for %llu ms", vf, (unsigned)cutoff,
+                    oLow ? (unsigned long long)(now - oLowStart) : 0ull);
+            }
+        }
+        if (cutNow) {
+            res.cover[C_LOWBAT_REACHED]++;
+            lowLatched = true;
+            lowbatEnter = now;
+            oLastLowBatBeep = now;
+            beaconsSeen = dshotBeacons;
+        }
+#ifdef USE_DSHOT
+        if (S == ST_LOWBAT && !cutNow) {
+            // every 3 s in the ticks that reach the program (not inhibited); the ESC beacon only while no receiver
+            // was seen since boot (a pilot could arm right after it), the buzzer always
+            const bool beacon = dshotBeacons != beaconsSeen;
+            beaconsSeen = dshotBeacons;
+            bool due = false;
+            if (!inhibit && now - oLastLowBatBeep >= 3000) {
+                oLastLowBatBeep = now;
+                due = !(rxSeenSure || rxConfirmed);
+            }
+            res.cover[C_BEACONS] += beacon && due;
+            res.cover[C_BEACON_RX_SKIPS] += !due && !inhibit && oLastLowBatBeep == now;
+            if (beacon != due) {
+                fail(V_LOWBAT_BEACON, "LOW_BATTERY for %llu ms: beacon %d, expected %d (receiver seen %d)",
+                    (unsigned long long)(now - lowbatEnter), beacon, due, rxSeenSure || rxConfirmed);
+            }
+        }
+#endif
+        // RX_LOST beeper: suppressed while enabled and no link was ever confirmed since boot
+        if (rxConfirmed) {
+            rxSeenSure = true;          // the module's rxSeen latches at the first confirmation
+        }
+        {
+            const bool suppress = autostartSuppressRxLostBeeper();
+            const bool enabled = live->mode != AUTOSTART_MODE_OFF;
+            if (suppress != (enabled && !rxSeenSure)) {
+                fail(V_RX_LOST_BEEPER, "suppress %d with mode %u, rx ever %d, rx confirmed %d", suppress, live->mode, rxEver, rxSeenSure);
+            }
+        }
+
+        prevS = S;
+        prevSrc = src;
+    }
+
+    // ---------------------------------------------------------------- one sequence
+    void onlyEvents(std::initializer_list<int> events, uint32_t profile)
+    {
+        for (int e = 0; e < EV_COUNT; e++) {
+            rate[e] = 0;
+        }
+        for (int e : events) {
+            rate[e] = baseRate[e] * profile / 4;
+        }
+    }
+
+    void runSequence(int n)
+    {
+        seqNo = n;
+        log.clear();
+        memset(trace, 0, sizeof(trace));
+        traceN = 0;
+        memset(reported, 0, sizeof(reported));
+        res.cover[C_SEQUENCES]++;
+
+        // world and settings
+        randomConfig(&stored, true);
+        *autostartConfigMutable() = stored;
+        static const uint32_t profiles[] = { 0, 1, 4, 4, 16 };
+        const uint32_t profile = profiles[r.below(5)];
+        for (int e = 0; e < EV_COUNT; e++) {
+            rate[e] = (r.below(100) < 65) ? baseRate[e] * profile / 4 : 0;
+        }
+        rate[EV_WARP] = 1;
+        now = 0;
+        endAt = 20 * r.range(1500, 12000);                 // 30 s .. 4 min
+        const bool gate = stored.vbatMinDeciVolts != 0;
+        usb = r.below(2);
+        batt = gate ? (r.below(4) != 0) : true;
+        if (!usb && !batt) {
+            usb = true;
+        }
+        warps = 0;
+        lastUpGlitch = 0;
+        battPlug = 0;
+        battUnplug = 0;
+        replugAt = unplugAt = pressAt = depleteAt = 0;
+        backfeed = gate ? (uint16_t)r.below(MIN(51u, (uint32_t)stored.vbatMinDeciVolts * 10u)) : (uint16_t)r.below(51);
+        riseMs = r.range(0, 1500);
+        sagUntil = glitchUntil = 0;
+        rx = r.below(7) == 0;
+        rxChange = 0;
+        rxGlitchUntil = 0;
+        box = stored.rcBoxPermanentId == 42 && r.below(2) ? BOXUSER3 : BOXID_NONE;
+        pressed = false;
+        pressUntil = 0;
+        buttonChange = 0;
+        spikeRate = r.below(10) < 7 ? 0 : (r.below(2) ? 300 : 1000);
+        cli = false;
+        armed = false;
+        armedUntil = 0;
+        f3d = r.below(20) == 0;
+        f3dUntil = f3d ? 20 * r.range(1, 3000) : 0;
+        // scenario families, so that every corner gets enough coverage
+        const uint32_t scenario = r.below(6);
+        res.cover[C_SCENARIO_RANDOM + scenario]++;
+        switch (scenario) {
+        case 1:     // quiet: battery-only or USB power-on runs with few disturbances
+            stored.mode = r.below(10) < 7 ? AUTOSTART_MODE_POWER : stored.mode;
+            stored.delaySeconds = MIN(stored.delaySeconds, (uint16_t)r.range(0, 20));
+            stored.rampDeciseconds = MIN(stored.rampDeciseconds, (uint16_t)r.range(0, 200));
+            batt = true;
+            rx = false;
+            onlyEvents({ EV_SAG, EV_DEPLETE, EV_RECOVER, EV_GLITCH_DOWN, EV_PRESS, EV_BOUNCE, EV_USB, EV_WARP }, r.below(3));
+            break;
+        case 2:     // RC switch with a receiver link
+            stored.rcBoxPermanentId = 42;
+            stored.delaySeconds = MIN(stored.delaySeconds, (uint16_t)r.range(0, 8));
+            stored.rampDeciseconds = MIN(stored.rampDeciseconds, (uint16_t)r.range(0, 80));
+            stored.runTimeSeconds = r.below(3) ? (uint16_t)r.range(1, 30) : stored.runTimeSeconds;
+            batt = true;
+            rx = true;
+            box = BOXUSER3;
+            onlyEvents({ EV_BOX, EV_RX_GLITCH, EV_RX, EV_SAG, EV_DEPLETE, EV_RECOVER, EV_PRESS, EV_UNPLUG, EV_PLUG, EV_WARP }, 1 + r.below(4));
+            break;
+        case 3:     // button
+            stored.mode = AUTOSTART_MODE_BUTTON;
+            stored.buttonTag = 1;
+            stored.delaySeconds = MIN(stored.delaySeconds, (uint16_t)r.range(0, 10));
+            stored.rampDeciseconds = MIN(stored.rampDeciseconds, (uint16_t)r.range(0, 100));
+            onlyEvents({ EV_PRESS, EV_BOUNCE, EV_SPIKES, EV_SAG, EV_DEPLETE, EV_RECOVER, EV_UNPLUG, EV_PLUG, EV_USB, EV_RX_GLITCH, EV_WARP }, 2 + r.below(8));
+            break;
+        case 4:     // USB bench: board on USB, battery plugged in later
+            usb = true;
+            batt = !gate;
+            stored.usbInhibit = r.below(10) < 7 ? 0 : stored.usbInhibit;
+            onlyEvents({ EV_PLUG, EV_UNPLUG, EV_GLITCH_UP, EV_GLITCH_DOWN, EV_CLI_ENTER, EV_CLI_EXIT, EV_CLI_MOTOR, EV_MSP, EV_REBOOT, EV_PRESS, EV_WARP }, 1 + r.below(4));
+            break;
+        case 5:     // the person at the computer
+            usb = true;
+            stored.usbInhibit = r.below(10) < 8 ? 0 : stored.usbInhibit;
+            stored.motorMask = r.below(2) ? 0x0F : stored.motorMask;
+            stored.delaySeconds = MIN(stored.delaySeconds, (uint16_t)r.range(0, 6));
+            onlyEvents({ EV_CLI_ENTER, EV_CLI_EXIT, EV_CLI_MOTOR, EV_MSP, EV_FOREIGN, EV_REBOOT, EV_ARM, EV_3D, EV_USB, EV_WARP }, 4 + r.below(12));
+            break;
+        default:
+            break;
+        }
+        if (rate[EV_WARP]) {
+            rate[EV_WARP] = r.below(100) < 30 ? 4000 : 0;
+        }
+        *autostartConfigMutable() = stored;
+        note("sequence %u: %s", (unsigned)scenario, configText(stored).c_str());
+        note("world: battery %d (%u cells, %u cV), usb %d, rx %d, box %d, spikes %u, 3D %d, profile %u", batt, physCells, packCv,
+            usb, rx, box, (unsigned)spikeRate, f3d, (unsigned)profile);
+
+        for (int i = 0; i < MAX_SUPPORTED_MOTORS; i++) {
+            motor_disarmed[i] = DISARM;
+        }
+        motor_disarmed[1] = OTHER;
+        mixerRuntime.disarmMotorOutput = DISARM;
+        boardOn = false;
+        booting = false;
+        taskOn = false;
+        powerTransitions();
+
+        while (now < endAt) {
+            randomEvents();
+            powerTransitions();
+            if (boardOn && booting && now >= initAt) {
+                finishBoot();
+            }
+            if (boardOn && !booting && taskOn) {
+                setInputs();
+                tick();
+            }
+            now += kTick;
+        }
+    }
+};
+
+static void runProperty(const uint32_t *seeds, int seedCount, int sequencesPerSeed, Results &res)
+{
+    for (int s = 0; s < seedCount; s++) {
+        Sim sim(seeds[s], res);
+        for (int n = 0; n < sequencesPerSeed; n++) {
+            sim.runSequence(n);
+        }
+    }
+}
+
+static void printResults(const Results &res)
+{
+    printf("[ PROPERTY ] coverage:");
+    for (int i = 0; i < C_COUNT; i++) {
+        printf(" %s=%ld", coverageNames[i], res.cover[i]);
+    }
+    printf("\n");
+    for (int v = 0; v < V_COUNT; v++) {
+        if (res.violations[v]) {
+            printf("[ PROPERTY ] VIOLATION %s x%ld, first:\n%s\n", violationNames[v], res.violations[v], res.first[v].c_str());
+        }
+    }
+}
