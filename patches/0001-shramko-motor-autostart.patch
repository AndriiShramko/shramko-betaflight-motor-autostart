+// Finding P1: with autostart_box and the RC switch left on, a battery cut-off does not latch: the very next
+// tick starts the program again (source RC), so a depleted pack is cycled: run ~cutoff_time, stop, run...
+// Docs: "After a cut-off the program stays stopped until the battery is unplugged and a battery is plugged in again".
+TEST(AutostartFindingTest, RcSwitchDoesNotRestartAfterCutoff)
+{
+    setDefaults(AUTOSTART_MODE_BUTTON);
+    autostartConfigMutable()->rcBoxPermanentId = 42;    // BOXUSER3
+    autostartConfigMutable()->delaySeconds = 0;
+    autostartConfigMutable()->rampDeciseconds = 0;
+    autostartConfigMutable()->cutoffTimeSeconds = 1;
+    debugMode = DEBUG_AUTOSTART;
+    autostartInit();
+    fakeRxValid = true;
+    fakeActiveBox = BOXUSER3;                   // switch on, and it stays on
+    runUntil(5000);
+    ASSERT_EQ(1150.0f, motor_disarmed[0]);      // runs from the switch
+    fakeVbat = 1900;                            // 19.00 V < 19.80 V (6S x 3.30 V): depleted
+    int cutoffs = 0, drivenAfterCut = 0, prev = debug[0];
+    for (timeMs_t t = 5020; t <= 30000; t += 20) {
+        runUntil(t);
+        cutoffs += (debug[0] == 5 && prev != 5);
+        drivenAfterCut += (cutoffs > 0 && motor_disarmed[0] > DISARM);
+        prev = debug[0];
+    }
+    EXPECT_EQ(1, cutoffs) << "the program was restarted after each cut-off";
+    EXPECT_EQ(0, drivenAfterCut) << "ticks with the motor driven on the depleted pack after the first cut-off";
+    EXPECT_EQ(5, debug[0]);
+}
+
+// Finding P2: with the RC switch left on, "run time over" (DONE) restarts the program on the next tick, so
+// autostart_run_time becomes a cycle (delay, ramp, run_time, again). Docs list "run time over" under
+// "What stops the program (no automatic restart)". Switching the switch off and on again is a user action.
+TEST(AutostartFindingTest, RcSwitchDoesNotRestartAfterRunTime)
+{
+    setDefaults(AUTOSTART_MODE_BUTTON);
+    autostartConfigMutable()->rcBoxPermanentId = 42;
+    autostartConfigMutable()->delaySeconds = 1;
+    autostartConfigMutable()->rampDeciseconds = 0;
+    autostartConfigMutable()->runTimeSeconds = 5;
+    debugMode = DEBUG_AUTOSTART;
+    autostartInit();
+    fakeRxValid = true;
+    fakeActiveBox = BOXUSER3;
+    runUntil(4000);                             // link confirmed, delay 1 s, ESC 3 s
+    ASSERT_EQ(1150.0f, motor_disarmed[0]);
+    timeMs_t doneAt = 0;
+    int drivenAfterDone = 0;
+    for (timeMs_t t = 4020; t <= 30000; t += 20) {
+        runUntil(t);
+        if (!doneAt && debug[0] == 4) {
+            doneAt = t;
+        } else if (doneAt) {
+            drivenAfterDone += motor_disarmed[0] > DISARM;
+        }
+    }
+    EXPECT_NE(0u, doneAt);
+    EXPECT_EQ(0, drivenAfterDone) << "DONE at " << doneAt << ", then the switch (still on) restarted it";
+    EXPECT_EQ(4, debug[0]);
+    fakeActiveBox = (boxId_e)BOXID_NONE;        // the pilot flips the switch off ...
+    runUntil(30500);
+    fakeActiveBox = BOXUSER3;                   // ... and on again: a new run is fine
+    runUntil(33000);
+    EXPECT_EQ(1150.0f, motor_disarmed[0]);
+}
+
+// Finding P3: when another writer changes only SOME of the program's motors, the module yields on all of them
+// (outputsWritten = false without releaseOutputs()), so the motors nobody else touched keep spinning at the
+// program's level, and debug[1] keeps showing the old percentage. Real path: the CLI "motor 0 1300" pasted
+// together with the CLI entry (both handled before the next autostart tick), mask with more than one motor.
+TEST(AutostartFindingTest, PartialForeignWriteStopsTheOtherMotors)
+{
+    setDefaults(AUTOSTART_MODE_POWER);
+    autostartConfigMutable()->usbInhibit = 0;
+    autostartConfigMutable()->motorMask = 0x05;     // motors 1 and 3
+    debugMode = DEBUG_AUTOSTART;
+    autostartInit();
+    runUntil(25000);
+    ASSERT_EQ(1150.0f, motor_disarmed[0]);
+    ASSERT_EQ(1150.0f, motor_disarmed[2]);
+    cliMode = true;                             // "#" ...
+    motor_disarmed[0] = 1300.0f;                // ... "motor 0 1300" in the same serial burst
+    runUntil(25100);
+    EXPECT_FALSE(autostartIsDrivingMotors());
+    EXPECT_EQ(1300.0f, motor_disarmed[0]);      // the CLI's value is kept (correct)
+    EXPECT_EQ(DISARM, motor_disarmed[2]);       // actual: 1150, motor 3 keeps blowing during the CLI session
+    EXPECT_EQ(0, debug[1]);                     // actual: 150 (15.0 %) while nothing is driven
+}
+
+// Finding P3, the common path: the web configurator's STOP (MSP_SET_MOTOR 1000 on all motors) during the ramp or
+// the run stops the motors correctly, but debug[1] (commanded percent, shown by the configurator) keeps the last value.
+TEST(AutostartFindingTest, StopViaMspClearsCommandedPercent)
+{
+    setDefaults(AUTOSTART_MODE_POWER);
+    autostartConfigMutable()->usbInhibit = 0;
+    debugMode = DEBUG_AUTOSTART;
+    autostartInit();
+    runUntil(25000);
+    ASSERT_EQ(150, debug[1]);                   // 15.0 %
+    for (int i = 0; i < 4; i++) {
+        motor_disarmed[i] = DISARM;             // MSP_SET_MOTOR 1000 x4 ...
+    }
+    autostartComputerTookOver();                // ... and its hook
+    runUntil(25100);
+    EXPECT_EQ(DISARM, motor_disarmed[0]);
