+// gusts: every output is either the steady level or a peak inside [gust_min, gust_max];
+// lengths and pauses stay inside their ranges; the peaks are not all the same (random)
+static void checkGusts(uint8_t base, uint8_t gMin, uint8_t gMax, uint8_t limit)
+{
+    autostartConfigMutable()->pattern = AUTOSTART_PATTERN_GUSTS;
+    autostartConfigMutable()->throttlePercent = base;
+    autostartConfigMutable()->gustMinPercent = gMin;
+    autostartConfigMutable()->gustMaxPercent = gMax;
+    autostartConfigMutable()->gustLenMinMs = 200;
+    autostartConfigMutable()->gustLenMaxMs = 600;
+    autostartConfigMutable()->gustPauseMinDs = 15;
+    autostartConfigMutable()->gustPauseMaxDs = 60;
+    autostartConfigMutable()->throttleLimit = limit;
+    autostartInit();
+    runUntil(20100);                    // ramp done
+    const float baseUs = 1000.0f + 10.0f * MIN(base, limit);
+    const float lo = 1000.0f + 10.0f * MIN(MIN(gMin, gMax), limit), hi = 1000.0f + 10.0f * MIN(MAX(gMin, gMax), limit);
+    int gusts = 0;
+    bool in = false;
+    timeMs_t edge = fakeMs;
+    float firstPeak = -1;
+    bool peaksDiffer = false;
+    for (timeMs_t t = fakeMs + 20; t < 200000; t += 20) {
+        runUntil(t);
+        const float v = motor_disarmed[0];
+        const bool gust = v != baseUs;
+        if (gust) {
+            EXPECT_GE(v, lo);
+            EXPECT_LE(v, hi);
+        }
+        if (gust != in) {
+            const timeMs_t len = t - edge;
+            if (in) {
+                EXPECT_GE(len, 180u);       // gust 200..600 ms (+- one 20 ms tick)
+                EXPECT_LE(len, 620u);
+            } else if (gusts > 0) {
+                EXPECT_GE(len, 1480u);      // pause 1.5..6 s
+                EXPECT_LE(len, 6020u);
+            }
+            if (gust) {
+                gusts++;
+                if (firstPeak < 0) {
+                    firstPeak = v;
+                } else if (v != firstPeak) {
+                    peaksDiffer = true;
+                }
+            }
+            in = gust;
+            edge = t;
+        }
+    }
+    EXPECT_GE(gusts, 25);               // 180 s / (1.5..6 s + 0.2..0.6 s) -> about 27..107
+    EXPECT_LE(gusts, 110);
+    if (lo != hi) {
+        EXPECT_TRUE(peaksDiffer);
+    }
+}
+
+TEST(AutostartTest, GustsStayInsideTheirRanges)
+{
+    setDefaults(AUTOSTART_MODE_POWER);
+    checkGusts(20, 50, 90, 100);
+}
+
+TEST(AutostartTest, GustsSwappedRangeAndLimit)
+{
+    setDefaults(AUTOSTART_MODE_POWER);
+    checkGusts(20, 90, 50, 60);         // min > max is swapped, peaks capped at 60 %
+}
