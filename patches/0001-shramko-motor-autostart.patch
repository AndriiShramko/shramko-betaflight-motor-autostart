+// The plain use: battery only (it powers the board), mode POWER, nothing else happens. Random settings:
+// RAMP starts at max(delay, 3 s) after power-on (+- one 20 ms tick), RUN after the ramp, DONE after the run time,
+// RUN holds min(throttle, limit), motors outside the mask keep their values.
+TEST(AutostartPropertyTest, CleanBatteryOnlyPowerRunIsOnTime)
+{
+    autostartprop::Prng r(0xC1EA4u);
+    int runs = 0, done = 0;
+    for (int n = 0; n < 250; n++) {
+        setDefaults(AUTOSTART_MODE_POWER);
+        autostartConfig_t *c = autostartConfigMutable();
+        c->delaySeconds = r.edge(0, 600, 0, 15);
+        c->rampDeciseconds = r.edge(0, 6000, 0, 150);
+        c->throttlePercent = r.edge(0, 100, 0, 100);
+        c->throttleLimit = r.edge(1, 100, 1, 100);
+        c->motorMask = r.edge(1, 255, 1, 15);
+        c->usbInhibit = r.below(2);
+        c->runTimeSeconds = r.below(2) ? 0 : r.edge(1, 65535, 1, 40);
+        c->pattern = AUTOSTART_PATTERN_STEADY;
+        c->cells = r.edge(0, 12, 1, 12);
+        fakeCells = r.range(0, 12);
+        const int cells = c->cells ? c->cells : (fakeCells ? fakeCells : 6);
+        fakeVbat = cells * 420;                     // full pack
+        c->cellCutoffCv = r.below(4) ? r.edge(0, 400, 250, 400) : 0;
+        c->cutoffTimeSeconds = r.edge(1, 60, 1, 10);
+        c->vbatMinDeciVolts = r.range(0, MIN(600, fakeVbat / 10));
+        debugMode = DEBUG_AUTOSTART;
+        fakeMs = 20 * r.range(50, 100);             // first tick 1.0 .. 2.0 s after power-on
+        const timeMs_t firstTick = fakeMs;
+        autostartInit();
+        autostartUpdate(fakeMs * 1000);
+        const timeMs_t expectRamp = MAX(MAX((timeMs_t)c->delaySeconds * 1000, (timeMs_t)3000), firstTick + 300);
+        const timeMs_t rampMs = c->rampDeciseconds * 100;
+        const uint8_t limit = c->throttleLimit;
+        const float steady = 1000.0f + (MIN(c->throttlePercent, limit) ? 10.0f * MIN(c->throttlePercent, limit) : 0.0f);
+        const uint8_t mask = c->motorMask;
+        timeMs_t rampAt = 0, runAt = 0, doneAt = 0;
+        const timeMs_t endMs = expectRamp + MAX(rampMs, (timeMs_t)20) + MIN((timeMs_t)c->runTimeSeconds * 1000 + 1000, (timeMs_t)60000) + 40;
+        while (fakeMs < endMs) {
+            fakeMs += 20;
+            tickReadIndex = 0;
+            autostartUpdate(fakeMs * 1000);
+            const int st = debug[0];
+            if (st == 2 && !rampAt) {
+                rampAt = fakeMs;
+            }
+            if (st == 3 && !runAt) {
+                runAt = fakeMs;
+            }
+            if (st == 4 && !doneAt) {
+                doneAt = fakeMs;
+            }
+            if (st == 3) {
+                for (int i = 0; i < 4; i++) {
+                    if (mask & (1 << i)) {
+                        ASSERT_EQ(steady, motor_disarmed[i]) << "run " << n << " motor " << i;
+                    }
+                }
+            }
+            for (int i = 0; i < MAX_SUPPORTED_MOTORS; i++) {
+                if (i >= 4 || !(mask & (1 << i))) {
+                    ASSERT_EQ(i == 1 ? OTHER : DISARM, motor_disarmed[i]) << "run " << n << " motor " << i << " is not in the mask";
+                }
+            }
+            ASSERT_NE(5, st) << "run " << n << ": cut-off with a full pack";
+        }
+        runs++;
+        ASSERT_NE(0u, rampAt) << "run " << n << ": the ramp never started";
+        EXPECT_NEAR((double)expectRamp, (double)rampAt, 20.0) << "run " << n << " delay " << c->delaySeconds << " first tick " << firstTick;
+        ASSERT_NE(0u, runAt) << "run " << n;
+        EXPECT_NEAR((double)(rampAt + MAX(rampMs, (timeMs_t)20)), (double)runAt, 20.0) << "run " << n << " ramp " << rampMs;
+        if (c->runTimeSeconds && (timeMs_t)c->runTimeSeconds * 1000 + 1000 <= 60000) {
+            done++;
+            EXPECT_NEAR((double)(runAt + c->runTimeSeconds * 1000), (double)doneAt, 20.0) << "run " << n;
+        } else {
+            EXPECT_EQ(0u, doneAt) << "run " << n << ": stopped although run_time is " << c->runTimeSeconds;
+        }
+    }
+    EXPECT_EQ(250, runs);
+    EXPECT_GT(done, 40);
+}
