+// Finding P5: escHadTimeToArm() compares millis() with powerDetectMs, which is 0 when the battery powered the
+// board. After 2^31 ms (24.8 days) of uptime cmpTimeMs() turns negative: a click starts a countdown that never
+// ends (until millis() wraps at 49.7 days), and - worse - the battery cut-off is never checked, so a running
+// blower drains the pack. A re-plugged battery hits the same 24.8 days after its own plug-in.
+// The jump of millis() stands for 24.8 days of identical idle ticks: the module only keeps timestamps.
+TEST(AutostartFindingTest, ClickAfter2pow31msUptimeStillRamps)
+{
+    setDefaults(AUTOSTART_MODE_BUTTON);
+    autostartConfigMutable()->buttonTag = 1;
+    autostartConfigMutable()->delaySeconds = 2;
+    debugMode = DEBUG_AUTOSTART;
+    autostartInit();
+    runUntil(10000);                            // battery confirmed at boot, idle, button released
+    fakeMs = 0x80000000u + 1000;                // 24.8 days later
+    ticks(5);
+    fakePinHigh = false;                        // click
+    ticks(5);
+    fakePinHigh = true;
+    ticks(5);
+    ASSERT_EQ(1, debug[0]);                     // the countdown started
+    ticks(150);                                 // 3 s: delay 2 s is over, the ESC has been powered for weeks
+    EXPECT_TRUE(debug[0] == 2 || debug[0] == 3) << "still in state " << debug[0] << " (1 = countdown)";
+}
