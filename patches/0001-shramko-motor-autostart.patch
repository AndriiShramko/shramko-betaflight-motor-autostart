+ * Betaflight is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.
+ *
+ * See the GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public
+ * License along with this software.
+ *
+ * If not, see <http://www.gnu.org/licenses/>.
+ */
+
+/*
+ * Shramko Motor Autostart (author: Andrii Shramko).
+ *
+ * Arbitration, evaluated every tick (50 Hz), highest priority first:
+ *   1. ARMED, FEATURE_3D, or (autostart_usb_inhibit and a USB host has configured the VCP)
+ *      -> program stopped, our motor_disarmed[] entries released, boot trigger consumed.
+ *   2. RX link valid for AUTOSTART_RX_CONFIRM_MS -> stock Betaflight owns the motors:
+ *      program stopped, unless autostart_box (BOXUSER1..4) is active, in which case the
+ *      same program (delay -> ramp -> hold) runs while the box stays active. The box starts it
+ *      only from IDLE: after the run time (DONE) it must be switched off and on again, after a
+ *      battery cut-off (LOW_BATTERY) only a new battery starts it again.
+ *   3. No RX link -> button click toggles the program; mode POWER starts it once at boot.
+ *      A program that was started by the RC box is stopped when the link is lost.
+ *
+ * Output: motor_disarmed[] (flight/mixer.c applyMixToMotors() copies it to motor[] while
+ * disarmed), i.e. exactly what MSP_SET_MOTOR / the CLI "motor" command write.
+ */
+
+#include <math.h>
+#include <stdbool.h>
+#include <stdint.h>
+
+#include "platform.h"
+
+#ifdef USE_AUTOSTART
+
+#include "common/filter.h"      // pt1Filter_t, needed by flight/mixer_init.h
+#include "common/maths.h"
+#include "common/time.h"
+#include "common/utils.h"
+
+#include "build/debug.h"
+
+#include "cli/cli.h"
+
+#include "config/feature.h"
+
+#ifdef USE_DSHOT
+#include "drivers/dshot.h"
+#include "drivers/dshot_command.h"
+#include "pg/motor.h"
+#endif
+#include "drivers/io.h"
+#include "drivers/motor.h"
+#include "drivers/time.h"
+#ifdef USE_VCP
+#include "drivers/usb_io.h"
+#endif
+
+#include "fc/rc_modes.h"
+#include "fc/runtime_config.h"
+
+#include "flight/mixer.h"
+#include "flight/mixer_init.h"
+
+#include "io/beeper.h"
+
+#include "msp/msp_box.h"
+
+#include "pg/autostart.h"
+
+#include "rx/rx.h"
+
+#include "sensors/battery.h"
+
+#include "fc/autostart.h"
+
+// never drive before 3 s uptime and 3 s after the battery appeared (USB host can enumerate, the ESC gets stop
+// frames; they start at motorEnable() at the end of init, so with the battery at boot the ESC sees ~1.5 s less)
+#define AUTOSTART_MIN_UPTIME_MS      3000
+#define AUTOSTART_DEBOUNCE_MS        60      // button level must be stable this long (3+ ticks)
+#define AUTOSTART_BUTTON_READS       8       // pin reads per tick; all must agree (rejects coupled spikes)
+#define AUTOSTART_RX_CONFIRM_MS      500     // RX link must stay valid this long before it takes over
+#define AUTOSTART_COUNTDOWN_BEEP_MS  1000    // one short beep per second during the delay
+#define AUTOSTART_POWER_CONFIRM_MS   300     // battery voltage must be stable this long to count as plugged in
+#define AUTOSTART_POWER_LOSS_MS      500     // ... and absent this long to count as unplugged (ignores ADC glitches)
+#define AUTOSTART_POWER_GONE_TICKS   2       // with a USB host the board outlives the battery: < 1 V this many ticks = unplugged
+#define AUTOSTART_BOOT_POWER_WINDOW_MS 2500  // battery seen this early = it powered the board: count from boot
+#define AUTOSTART_LOWBAT_BEEP_MS     3000    // after a cut-off: ESC beacon / buzzer every 3 s
+#define AUTOSTART_NO_BATTERY_CV      100     // below 1.00 V there is no battery to protect (USB-only bench)
+#define AUTOSTART_CELL_PLAUSIBLE_MIN 250     // a LiPo cell reads 2.50..4.45 V; outside that the voltage
+#define AUTOSTART_CELL_PLAUSIBLE_MAX 445     // calibration (vbat_scale) or the cell count is wrong
+#define AUTOSTART_CELL_CUTOFF_MIN    250     // autostart_cell_cutoff 1..249 is raised to this (docs: 0 or 250..420)
+
+typedef enum {
+    AUTOSTART_STATE_IDLE = 0,
+    AUTOSTART_STATE_DELAY,
+    AUTOSTART_STATE_RAMP,
+    AUTOSTART_STATE_RUN,
+    AUTOSTART_STATE_DONE,       // run time over, outputs at stop
+    AUTOSTART_STATE_LOWBAT,     // battery cut-off, outputs at stop, latched until the battery is replaced
+} autostartState_e;
+
+typedef enum {
+    AUTOSTART_SOURCE_NONE = 0,
+    AUTOSTART_SOURCE_POWER,
+    AUTOSTART_SOURCE_BUTTON,
+    AUTOSTART_SOURCE_RCBOX,
+} autostartSource_e;
+
+static autostartState_e state = AUTOSTART_STATE_IDLE;
+static autostartSource_e source = AUTOSTART_SOURCE_NONE;
+static timeMs_t stateStartMs;
+static timeMs_t lastBeepMs;
+static bool powerTriggerPending;
+static bool heldByComputer;          // see autostartComputerTookOver(): no start until a reboot
+static bool outputsWritten;
+static bool uptimeReached;
+
+static bool rxSeen;
+static bool rxWasValid;
+static timeMs_t rxValidSinceMs;
+static bool rxConfirmedLatched;     // latched: comparing with an old timestamp turns negative after 2^31 ms (24.8 days)
+
+static uint8_t rcBoxId = BOXID_NONE;
+
+static int16_t commandedPermille;   // last commanded output, percent x10 (debug only)
+
+// Program parameters are copied at start and used until the next start: a CLI "set" while the
+// motor runs must never step the output (the live config is written immediately by the CLI).
+typedef struct {
+    uint16_t delaySeconds;
+    uint16_t rampDeciseconds;
+    uint8_t throttlePercent;
+    uint8_t throttleLimit;
+    uint8_t motorMask;
+    uint8_t pattern;
+    uint16_t runTimeSeconds;
+    uint8_t gustMin, gustMax;       // %, min <= max
+    uint16_t gustLenMin, gustLenMax;        // ms
+    uint32_t gustPauseMin, gustPauseMax;    // ms
+    uint16_t cellCutoffCv;          // per cell, 0.01 V; 0 = off
+    uint8_t cutoffTimeSeconds;
+} autostartProgram_t;
+static autostartProgram_t program;
+static float lastWritten;           // value we put into motor_disarmed[] for our motors
+
+// gusts (pattern GUSTS, state RUN)
+static bool gustActive;
+static uint8_t gustPeak;
+static timeMs_t gustEdgeMs;         // end of the current gust, or start of the next one
+static uint32_t rngState = 1;
+
+// extended DShot telemetry (ESC voltage / temperature) is requested once per battery power-up
+static bool edtRequested;
+
+// battery cut-off
+static bool lowSince;
+static timeMs_t lowSinceMs;
+static timeMs_t lastLowBatBeepMs;
+
+// Battery power. The ESC has no BEC: it only wakes up (and arms on stop frames) when the battery is
+// plugged in. On USB the board runs without a battery, so the countdown must start at the battery,
+// otherwise the ESC would power up into a running ramp and refuse to arm.
+static bool powerRaw;
+static timeMs_t powerRawChangeMs;
+static bool powerPresent;
+static timeMs_t powerSinceMs;       // countdown origin: 0 when the battery powered the board, else plug-in time
+static timeMs_t powerDetectMs;      // ESC power-up: 0 if the battery was there at the first check, else when it appeared
+static bool powerFirstCheckDone;
+static bool powerAtFirstCheck;
+static bool bootWindowOver;         // latched (millis() wraps after 49.7 days): later raw changes are not "at boot"
+static bool powerRawChangeAtBoot;   // the last raw change happened inside AUTOSTART_BOOT_POWER_WINDOW_MS
+static uint8_t noBatteryTicks;      // consecutive ticks with the latest reading below AUTOSTART_NO_BATTERY_CV
+static bool escReady;               // the ESC had its 3 s of stop frames (escReadyUpdate()), latched like rxConfirmedLatched
+
+static IO_t buttonIo = IO_NONE;
+static bool buttonRawPressed;
+static bool buttonRawValid;         // false after mixed reads: the next consistent level counts as a fresh change
+static bool buttonStablePressed;
+static timeMs_t buttonChangeMs;
+
+static int autostartMotorCount(void)
+{
+    return MIN((int)getMotorCount(), MAX_SUPPORTED_MOTORS);
+}
+
+// percent of the motor-test range: 0 % -> disarm value (DShot stop command / PWM mincommand),
+// 0.1..100 % -> external 1001..2000, converted by the active protocol like MSP_SET_MOTOR does.
+static void writeOutputs(float percent)
+{
+    const float pct = constrainf(percent, 0.0f, (float)program.throttleLimit);
+    commandedPermille = (int16_t)lrintf(pct * 10.0f);
+    const uint16_t external = PWM_RANGE_MIN + (uint16_t)lrintf(pct * (PWM_RANGE_MAX - PWM_RANGE_MIN) / 100.0f);
+    const float value = (external <= PWM_RANGE_MIN) ? mixerRuntime.disarmMotorOutput : motorConvertFromExternal(external);
+    const uint8_t mask = program.motorMask;
+
+    for (int i = 0; i < autostartMotorCount(); i++) {
+        if (mask & (1U << i)) {
+            motor_disarmed[i] = value;
+        }
+    }
+    lastWritten = value;
+    outputsWritten = true;
+}
+
+static void releaseOutputs(void)
+{
+    commandedPermille = 0;
+    if (!outputsWritten) {
+        return;
+    }
+    const uint8_t mask = program.motorMask;
+    for (int i = 0; i < autostartMotorCount(); i++) {
+        // a motor another writer (CLI "motor", Motors tab) changed keeps its value; ours go back to stop
+        if ((mask & (1U << i)) && motor_disarmed[i] == lastWritten) {
+            motor_disarmed[i] = mixerRuntime.disarmMotorOutput;
+        }
+    }
+    outputsWritten = false;
+}
+
+// DELAY / RAMP / RUN; DONE and LOWBAT are finished programs that only wait for a new battery
+static bool programActive(void)
+{
+    return state == AUTOSTART_STATE_DELAY || state == AUTOSTART_STATE_RAMP || state == AUTOSTART_STATE_RUN;
+}
+
+static uint32_t rngNext(void)
+{
+    // xorshift32: cheap, never 0 once seeded with a non-zero value
+    rngState ^= rngState << 13;
+    rngState ^= rngState >> 17;
+    rngState ^= rngState << 5;
+    return rngState;
+}
+
+static uint32_t rngRange(uint32_t lo, uint32_t hi)
+{
+    if (lo > hi) {
+        const uint32_t t = lo; lo = hi; hi = t;
+    }
+    return lo + rngNext() % (hi - lo + 1);
+}
+
+// seeded at the first RUN tick: the exact moment and the ADC noise differ on every power-up, while millis() of a
+// power-on start is nearly the same every time (the gusts would repeat on every boot)
+static void rngSeed(void)
+{
+    rngState = (micros() * 2654435761U) ^ ((uint32_t)getBatteryVoltageLatest() * 40503U) ^ 0x9E3779B9U;
+    if (rngState == 0) {
+        rngState = 1;
+    }
+}
+
+static uint8_t batteryCells(void)
+{
+    const uint8_t cells = autostartConfig()->cells;
+    return cells ? cells : getBatteryCellCount();
+}
+
+// the measured pack voltage cannot be a LiPo of this cell count: tell the configurator (debug bit 5)
+static bool batteryVoltageSuspect(void)
+{
+    const uint16_t vbat = getBatteryVoltage();
+    const uint8_t cells = batteryCells();
+    // escReady: like the cut-off, wait the ~1.5 s Betaflight's filtered voltage needs to rise after a plug-in
+    if (!powerPresent || !escReady || cells == 0 || vbat < AUTOSTART_NO_BATTERY_CV) {
+        return false;
+    }
+    const uint16_t perCell = vbat / cells;
+    return perCell < AUTOSTART_CELL_PLAUSIBLE_MIN || perCell > AUTOSTART_CELL_PLAUSIBLE_MAX;
+}
+
+static bool outputsOverwritten(void)
+{
+    if (!outputsWritten) {
+        return false;
+    }
+    for (int i = 0; i < autostartMotorCount(); i++) {
+        if ((program.motorMask & (1U << i)) && motor_disarmed[i] != lastWritten) {
+            return true;
+        }
+    }
+    return false;
+}
+
+static void programStart(autostartSource_e newSource, timeMs_t nowMs)
+{
+    const autostartConfig_t *cfg = autostartConfig();
+    program.delaySeconds = cfg->delaySeconds;
+    program.rampDeciseconds = cfg->rampDeciseconds;
+    program.throttleLimit = constrain(cfg->throttleLimit, 1, 100);
+    program.throttlePercent = MIN(cfg->throttlePercent, program.throttleLimit);
+    program.motorMask = cfg->motorMask;
+    program.pattern = cfg->pattern;
+    program.runTimeSeconds = cfg->runTimeSeconds;
+    // gusts are bursts on top of the steady level: a peak below it is raised to it (a 0 % "gust" would be a
+    // DShot STOP in the middle of the run)
+    program.gustMin = MAX(MIN(cfg->gustMinPercent, cfg->gustMaxPercent), program.throttlePercent);
+    program.gustMax = MAX(MAX(cfg->gustMinPercent, cfg->gustMaxPercent), program.gustMin);
+    program.gustLenMin = MIN(cfg->gustLenMinMs, cfg->gustLenMaxMs);
+    program.gustLenMax = MAX(cfg->gustLenMinMs, cfg->gustLenMaxMs);
+    program.gustPauseMin = MIN(cfg->gustPauseMinDs, cfg->gustPauseMaxDs) * 100U;
+    program.gustPauseMax = MAX(cfg->gustPauseMinDs, cfg->gustPauseMaxDs) * 100U;
+    // the CLI accepts 1..249, which would mean almost no protection (6 x 0.33 V): raise it to 2.50 V/cell
+    program.cellCutoffCv = cfg->cellCutoffCv ? MAX(cfg->cellCutoffCv, AUTOSTART_CELL_CUTOFF_MIN) : 0;
+    program.cutoffTimeSeconds = MAX(cfg->cutoffTimeSeconds, 1);
+    gustActive = false;
+    lowSince = false;
+    source = newSource;
+    state = AUTOSTART_STATE_DELAY;
+    // power-on start counts the delay from the moment the battery appeared ("plug in, 1, 2, 3 ... 10";
+    // on battery-only power that is the boot itself), a click or an RC switch from the event itself
+    stateStartMs = (newSource == AUTOSTART_SOURCE_POWER) ? powerSinceMs : nowMs;
+    lastBeepMs = nowMs - AUTOSTART_COUNTDOWN_BEEP_MS; // first countdown beep on the next tick
+}
+
+static void programStop(timeMs_t nowMs)
+{
+    releaseOutputs();
+    source = AUTOSTART_SOURCE_NONE;
+    state = AUTOSTART_STATE_IDLE;
+    stateStartMs = nowMs;
+    gustActive = false;
+}
+
+// run time over or battery cut-off: motor to stop, remember why
+static void programFinish(autostartState_e why, timeMs_t nowMs)
+{
+    releaseOutputs();
+    state = why;
+    stateStartMs = nowMs;
+    gustActive = false;
+    lastLowBatBeepMs = nowMs;
+}
+
+// true while the pack has stayed below the cut-off for the configured time
+static bool batteryCutoffReached(timeMs_t nowMs)
+{
+    const uint16_t vbat = getBatteryVoltage();      // filtered, 0.01 V
+    // cell count resolved every check: with auto-detection Betaflight may know it only after a while
+    const uint32_t cutoff = (uint32_t)program.cellCutoffCv * batteryCells();
+    // escReady: Betaflight's filtered voltage needs ~1.5 s to rise after the battery appears
+    // (measured 20.10: 14.8 V -> 22.0 V on a 22.3 V pack); counting before that tripped a high cut-off
+    // with a short cut-off time on every power-up. The motor cannot run in those 3 s anyway.
+    if (cutoff == 0 || vbat < AUTOSTART_NO_BATTERY_CV || !isBatteryVoltageConfigured() || !escReady) {
+        lowSince = false;
+        return false;
+    }
+    if (vbat >= cutoff) {
+        lowSince = false;
+        return false;
+    }
+    if (!lowSince) {
+        lowSince = true;
+        lowSinceMs = nowMs;
+    }
+    return cmpTimeMs(nowMs, lowSinceMs) >= (timeDelta_t)(program.cutoffTimeSeconds * 1000U);
+}
+
+// returns true once per press (falling edge to GND after AUTOSTART_DEBOUNCE_MS of stable level)
+static bool buttonClicked(timeMs_t nowMs)
+{
+    if (!buttonIo) {
+        return false;
+    }
+
+    // internal pull-up: released = high, pressed (to GND) = low; a spike coupled from the ESC wiring
+    // must not look like a press, so all reads of this tick have to agree
+    int lowReads = 0;
+    for (int i = 0; i < AUTOSTART_BUTTON_READS; i++) {
+        lowReads += IORead(buttonIo) ? 0 : 1;
+    }
+    if (lowReads != 0 && lowReads != AUTOSTART_BUTTON_READS) {
+        buttonChangeMs = nowMs;     // mixed reads: treat as unstable
+        buttonRawValid = false;
+        return false;
+    }
+    const bool rawPressed = (lowReads == AUTOSTART_BUTTON_READS);
+
+    // after noise the level counts from its first consistent tick, even if it equals the last known one:
+    // otherwise a 40 ms touch after noisy ticks could pass the 60 ms debounce
+    if (rawPressed != buttonRawPressed || !buttonRawValid) {
+        buttonRawPressed = rawPressed;
+        buttonRawValid = true;
+        buttonChangeMs = nowMs;
+        return false;
+    }
+
+    if (rawPressed != buttonStablePressed && cmpTimeMs(nowMs, buttonChangeMs) >= AUTOSTART_DEBOUNCE_MS) {
+        buttonStablePressed = rawPressed;
+        return rawPressed;
+    }
+
+    return false;
+}
+
+static bool usbHostPresent(void)
+{
+#ifdef USE_VCP
+    // no USB_DETECT pin on this board: true once the host has configured the VCP (see drivers/usb_io.c)
+    return usbCableIsInserted();
+#else
+    return false;
+#endif
+}
+
+static bool rcBoxActive(void)
+{
+    return rcBoxId != BOXID_NONE && IS_RC_MODE_ACTIVE((boxId_e)rcBoxId);
+}
+
+static bool batteryPowerRaw(const autostartConfig_t *cfg)
+{
+    if (cfg->vbatMinDeciVolts == 0 || !isBatteryVoltageConfigured()) {
+        return true;    // gating disabled: behave as if the battery is always there
+    }
+    uint32_t thresholdCv = cfg->vbatMinDeciVolts * 10U;    // 0.01 V units: plugged in at autostart_vbat_min
+    if (powerRaw) {
+        // once seen, load sag is not an unplug: a connected LiPo never reads below 2.50 V per cell, so a
+        // vbat_min above that ("start only with a charged pack") does not stop and restart the program
+        const uint32_t floorCv = (uint32_t)batteryCells() * AUTOSTART_CELL_PLAUSIBLE_MIN;
+        if (floorCv && floorCv < thresholdCv) {
+            thresholdCv = floorCv;
+        }
+    }
+    return getBatteryVoltageLatest() >= thresholdCv;
+}
+
+// the ESC has had at least AUTOSTART_MIN_UPTIME_MS of stop frames since it got power; updated every tick and
+// latched, so it cannot turn false again when cmpTimeMs() of an old timestamp goes negative after 2^31 ms
+static void escReadyUpdate(timeMs_t nowMs)
+{
+    if (!uptimeReached || !powerPresent) {
+        escReady = false;
+    } else if (!escReady && cmpTimeMs(nowMs, powerDetectMs) >= AUTOSTART_MIN_UPTIME_MS) {
+        escReady = true;
+    }
+}
+
+// debug_mode = AUTOSTART: [0] state, [1] commanded percent x10,
+// [2] ms in current state / 10, sent as uint16 (the configurator reads it unsigned): stops at 655.35 s,
+// [3] uptime in 0.1 s, stops at 3276.7 s, [4] flags (bit0 USB host, bit1 RX link, bit2 button pressed,
+//     bit3 battery present, bit4 gust, bit5 battery voltage implausible for the cell count = calibrate vbat_scale,
+//     bit6 held by the computer: a CLI session, a motor write or STOP happened, no start until a reboot),
+// [5] battery voltage in 0.1 V, [6] time since the battery appeared in 0.1 s (-1 = no battery), stops at 3276.7 s,
+// [7] source. Elapsed times are unsigned differences, so they never read negative (valid for 49.7 days).
+
+static void autostartDebug(timeMs_t nowMs, bool rxValid)
+{
+    const int16_t flags = (usbHostPresent() ? 1 : 0) | (rxValid ? 2 : 0) | (buttonStablePressed ? 4 : 0) | (powerPresent ? 8 : 0)
+        | (gustActive ? 16 : 0) | (batteryVoltageSuspect() ? 32 : 0) | (heldByComputer ? 64 : 0);
+    const timeMs_t inStateMs = nowMs - stateStartMs;
+    const timeMs_t sinceBatteryMs = nowMs - powerSinceMs;
+    DEBUG_SET(DEBUG_AUTOSTART, 0, state);
+    DEBUG_SET(DEBUG_AUTOSTART, 1, commandedPermille);
+    DEBUG_SET(DEBUG_AUTOSTART, 2, (int16_t)(uint16_t)MIN(inStateMs / 10, (timeMs_t)UINT16_MAX));
+    DEBUG_SET(DEBUG_AUTOSTART, 3, (int16_t)MIN(nowMs / 100, (timeMs_t)INT16_MAX));
+    DEBUG_SET(DEBUG_AUTOSTART, 4, flags);
+    DEBUG_SET(DEBUG_AUTOSTART, 5, (int16_t)((getBatteryVoltageLatest() + 5) / 10));
+    DEBUG_SET(DEBUG_AUTOSTART, 6, powerPresent ? (int16_t)MIN(sinceBatteryMs / 100, (timeMs_t)INT16_MAX) : -1);
+    DEBUG_SET(DEBUG_AUTOSTART, 7, source);
+}
+
+bool autostartIsEnabled(void)
+{
+    return autostartConfig()->mode != AUTOSTART_MODE_OFF;
+}
+
+bool autostartIsDrivingMotors(void)
+{
+    return outputsWritten;
+}
+
+// called before the computer's own command (MSP_SET_MOTOR, ESC passthrough, MSP2_SEND_DSHOT_COMMAND): our motors
+// go to stop at once, because a passthrough runs outside the 50 Hz task, and the command's values are never stomped on
+void autostartComputerTookOver(void)
+{
+    heldByComputer = true;
+    powerTriggerPending = false;
+    if (programActive() || outputsWritten) {
+        programStop(millis());
+    }
+}
+
+// While this build runs receiverless (no RX link confirmed since boot) the stock RX_LOST
+// beeper would sound forever and, having priority 1, would mask the countdown beeps.
+bool autostartSuppressRxLostBeeper(void)
+{
+    return autostartIsEnabled() && !rxSeen;
+}
+
+void autostartInit(void)
+{
+    const autostartConfig_t *cfg = autostartConfig();
+
+    state = AUTOSTART_STATE_IDLE;
+    source = AUTOSTART_SOURCE_NONE;
+    outputsWritten = false;
+    uptimeReached = false;
+    rxSeen = false;
+    rxWasValid = false;
+    rxConfirmedLatched = false;
+    powerTriggerPending = false;       // armed when battery power is confirmed
+    heldByComputer = false;
+    powerRaw = false;
+    powerRawChangeMs = 0;
+    powerPresent = false;
+    powerSinceMs = 0;
+    powerDetectMs = 0;
+    powerFirstCheckDone = false;
+    powerAtFirstCheck = false;
+    bootWindowOver = false;
+    powerRawChangeAtBoot = false;
+    noBatteryTicks = 0;
+    escReady = false;
+    edtRequested = false;
+    commandedPermille = 0;
+
+    rcBoxId = BOXID_NONE;
+    if (cfg->rcBoxPermanentId != PERMANENT_ID_NONE) {
+        const box_t *box = findBoxByPermanentId(cfg->rcBoxPermanentId);
+        // only the otherwise unused user boxes are accepted, so no flight function is overloaded
+        if (box && box->boxId >= BOXUSER1 && box->boxId <= BOXUSER4) {
+            rcBoxId = box->boxId;
+        }
+    }
+
+    buttonIo = IO_NONE;
+    if (autostartIsEnabled() && cfg->buttonTag) {
+        const IO_t io = IOGetByTag(cfg->buttonTag);
+        // never take a pin another driver (UART, motor, LED strip...) already owns
+        if (io && IOIsFreeOrPreinit(io)) {
+            IOInit(io, OWNER_AUTOSTART, 0);
+            IOConfigGPIO(io, IOCFG_IPU);
+            buttonIo = io;
+            // a button held during boot is not a click: start from the current level
+            buttonRawPressed = !IORead(io);
+            buttonRawValid = true;
+            buttonStablePressed = buttonRawPressed;
+            buttonChangeMs = millis();
+        }
+    }
+}
+
+void autostartUpdate(timeUs_t currentTimeUs)
+{
+    UNUSED(currentTimeUs);
+
+    const autostartConfig_t *cfg = autostartConfig();
+    const timeMs_t nowMs = millis();
+
+    if (!uptimeReached && nowMs >= AUTOSTART_MIN_UPTIME_MS) {
+        uptimeReached = true;
+    }
+
+    // sample every tick so the debounce state is current
+    const bool clicked = buttonClicked(nowMs);
+
+    // battery power detection (see powerRaw)
+    if (!bootWindowOver && nowMs > AUTOSTART_BOOT_POWER_WINDOW_MS) {
+        bootWindowOver = true;
+    }
+    const bool rawPower = batteryPowerRaw(cfg);
+    if (!powerFirstCheckDone) {
+        powerFirstCheckDone = true;
+        powerAtFirstCheck = rawPower;   // battery already there: it powered the board (and the ESC) at boot
+    }
+    if (rawPower != powerRaw) {
+        powerRaw = rawPower;
+        powerRawChangeMs = nowMs;
+        powerRawChangeAtBoot = !bootWindowOver;
+        if (!rawPower) {
+            powerAtFirstCheck = false;  // gone before it was confirmed: it did not power the board
+        }
+    }
+    noBatteryTicks = (getBatteryVoltageLatest() < AUTOSTART_NO_BATTERY_CV) ? (uint8_t)MIN(noBatteryTicks + 1, UINT8_MAX) : 0;
+    const timeDelta_t powerStableMs = cmpTimeMs(nowMs, powerRawChangeMs);
+    if (!powerPresent && powerRaw && powerStableMs >= AUTOSTART_POWER_CONFIRM_MS) {
+        powerPresent = true;
+        powerDetectMs = powerAtFirstCheck ? 0 : powerRawChangeMs;
+        powerAtFirstCheck = false;      // a later re-plug counts from its own moment
+        powerSinceMs = powerRawChangeAtBoot ? 0 : powerRawChangeMs;
+        if (cfg->mode == AUTOSTART_MODE_POWER && !rxSeen) {
+            powerTriggerPending = true;     // battery plugged in: (re)start the power-on program
+        }
+    } else if (powerPresent && !powerRaw && (powerStableMs >= AUTOSTART_POWER_LOSS_MS
+        // on battery-only power a reading of 0 V with the board still running is an ADC glitch; with a USB host
+        // it is a real outage (connector bounce): the ESC browns out and must see stop frames when it is back
+        || (usbHostPresent() && noBatteryTicks >= AUTOSTART_POWER_GONE_TICKS))) {
+        powerPresent = false;               // battery unplugged: the ESC is off, stop and wait for it again
+        powerTriggerPending = false;
+        edtRequested = false;
+        if (state != AUTOSTART_STATE_IDLE || outputsWritten) {
+            programStop(nowMs);             // also clears DONE / LOW_BATTERY: a new battery starts again
+        }
+    }
+    escReadyUpdate(nowMs);
+
+    // a CLI session or another writer of motor_disarmed[] (Configurator Motors tab, CLI "motor",
+    // cliExit reset) stops the program for good: the person at the computer is in charge now.
+    // "For good" = until the board restarts, also while it only waits for a battery or a click.
+    if (cliMode || outputsOverwritten()) {
+        heldByComputer = true;
+    }
+    if (heldByComputer) {
+        powerTriggerPending = false;
+    }
+    if (programActive() && (cliMode || outputsOverwritten() || heldByComputer)) {   // also a STOP during the countdown
+        programStop(nowMs);     // releaseOutputs() leaves a motor the other writer changed alone, stops the rest
+        powerTriggerPending = false;
+    }
+
+    // 1. hard inhibits
+    if (ARMING_FLAG(ARMED)
+        || featureIsEnabled(FEATURE_3D)
+        || cliMode
+        || (cfg->usbInhibit && usbHostPresent())) {
+        if (programActive() || outputsWritten) {
+            programStop(nowMs);
+        }
+        powerTriggerPending = false;
+        autostartDebug(nowMs, rxAreFlightChannelsValid());
+        return;
+    }
+
+    // 2. RX link arbitration
+    const bool rxValidNow = rxAreFlightChannelsValid();
+    if (rxValidNow && !rxWasValid) {
+        rxValidSinceMs = nowMs;
+    }
+    rxWasValid = rxValidNow;
+    if (!rxValidNow) {
+        rxConfirmedLatched = false;
+    } else if (!rxConfirmedLatched && cmpTimeMs(nowMs, rxValidSinceMs) >= AUTOSTART_RX_CONFIRM_MS) {
+        rxConfirmedLatched = true;
+    }
+    const bool rxConfirmed = rxConfirmedLatched;
+
+    if (rxConfirmed) {
+        rxSeen = true;
+        powerTriggerPending = false;
+        if (rcBoxActive()) {
+            if (programActive()) {
+                source = AUTOSTART_SOURCE_RCBOX; // the switch now owns the running program
+            } else if (state == AUTOSTART_STATE_IDLE && powerPresent && !heldByComputer) {
+                // not from LOW_BATTERY (only a new battery clears it) nor from DONE (switch off and on again)
+                programStart(AUTOSTART_SOURCE_RCBOX, nowMs);
+            }
+        } else if (programActive() || state == AUTOSTART_STATE_DONE) {
+            programStop(nowMs);     // DONE: the switch is off, the next switch-on starts a new run
+        }
+    } else if (!rxValidNow) {
+        // 3. no RX link
+        if (programActive() && source == AUTOSTART_SOURCE_RCBOX) {
+            programStop(nowMs); // link lost while the RC switch was running the program
+        }
+
+        if (clicked && state != AUTOSTART_STATE_LOWBAT) {
+            powerTriggerPending = false;
+            if (programActive()) {
+                programStop(nowMs);
+                beeperConfirmationBeeps(2);
+            } else if (powerPresent && !heldByComputer) {
+                programStart(AUTOSTART_SOURCE_BUTTON, nowMs);
+            }
+        } else if (powerTriggerPending && powerPresent) {
+            powerTriggerPending = false;
+            programStart(AUTOSTART_SOURCE_POWER, nowMs);
+        }
+    }
+    // else: an RX link is appearing but not yet confirmed - start nothing new, keep the current program
+
+    // extended DShot telemetry: ESC voltage and temperature for the configurator, without arming
+    if (!edtRequested && escReady && !outputsWritten) {
+#if defined(USE_DSHOT) && defined(USE_DSHOT_TELEMETRY)
+        if (isMotorProtocolDshot() && useDshotTelemetry && motorConfig()->dev.useDshotEdt
+#ifdef USE_ESC_SENSOR
+            && !featureIsEnabled(FEATURE_ESC_SENSOR)
+#endif
+            ) {
+            // stock Betaflight silently drops the first inline command until 3 s after motorEnable() (end of
+            // init): with the battery at boot the ESC is ready earlier, so ask only once the command is accepted
+            if (dshotStreamingCommandsAreEnabled() && dshotCommandQueueEmpty()) {
+                dshotCommandWrite(ALL_MOTORS, getMotorCount(), DSHOT_CMD_EXTENDED_TELEMETRY_ENABLE, DSHOT_CMD_TYPE_INLINE);
+                edtRequested = true;
+            }
+        } else {
+            edtRequested = true;    // nothing to ask for
+        }
+#else
+        edtRequested = true;
+#endif
+    }
+
+    // 4. battery cut-off protects the pack in every running state (also during the countdown)
+    if (programActive() && batteryCutoffReached(nowMs)) {
+        programFinish(AUTOSTART_STATE_LOWBAT, nowMs);
+    }
+
+    // 5. run the program
+    switch (state) {
+    case AUTOSTART_STATE_IDLE:
+    case AUTOSTART_STATE_DONE:
+    default:
+        break;
+
+    case AUTOSTART_STATE_LOWBAT:
+        // tell the user why the blower stopped: ESC beacon (DShot, motor at stop) or the buzzer
+        if (cmpTimeMs(nowMs, lastLowBatBeepMs) >= AUTOSTART_LOWBAT_BEEP_MS) {
+            lastLowBatBeepMs = nowMs;
+#ifdef USE_DSHOT
+            // not once a receiver was seen: a pilot may arm, and stock Betaflight delays arming only after its
+            // own beacons (an ESC still playing the tone ignores the first throttle); the buzzer still beeps
+            if (isMotorProtocolDshot() && !rxSeen) {
+                dshotCommandWrite(ALL_MOTORS, getMotorCount(), DSHOT_CMD_BEACON3, DSHOT_CMD_TYPE_INLINE);
+            }
+#endif
+            beeperConfirmationBeeps(4);
+        }
+        break;
+
+    case AUTOSTART_STATE_DELAY:
+        if (escReady && cmpTimeMs(nowMs, stateStartMs) >= (timeDelta_t)(program.delaySeconds * 1000U)) {
+            state = AUTOSTART_STATE_RAMP;
+            stateStartMs = nowMs;
+            beeperConfirmationBeeps(3);
+        } else if (cmpTimeMs(nowMs, lastBeepMs) >= AUTOSTART_COUNTDOWN_BEEP_MS) {
+            lastBeepMs = nowMs;
+            beeperConfirmationBeeps(1);
+        }
+        break;
+
+    case AUTOSTART_STATE_RAMP: {
+        const timeDelta_t rampMs = (timeDelta_t)(program.rampDeciseconds * 100U);
+        const timeDelta_t elapsedMs = cmpTimeMs(nowMs, stateStartMs);
+        if (rampMs <= 0 || elapsedMs >= rampMs) {
+            state = AUTOSTART_STATE_RUN;
+            stateStartMs = nowMs;
+            gustActive = false;
+            rngSeed();
+            gustEdgeMs = nowMs + rngRange(program.gustPauseMin, program.gustPauseMax);
+            writeOutputs(program.throttlePercent);
+        } else {
+            writeOutputs((float)program.throttlePercent * (float)elapsedMs / (float)rampMs);
+        }
+        break;
+    }
+
+    case AUTOSTART_STATE_RUN:
+        if (program.runTimeSeconds && cmpTimeMs(nowMs, stateStartMs) >= (timeDelta_t)(program.runTimeSeconds * 1000U)) {
+            programFinish(AUTOSTART_STATE_DONE, nowMs);
+            break;
+        }
+        if (program.pattern == AUTOSTART_PATTERN_GUSTS) {
+            if (cmpTimeMs(nowMs, gustEdgeMs) >= 0) {
+                if (gustActive) {
+                    gustActive = false;     // back to the steady level, then wait a random pause
+                    gustEdgeMs = nowMs + rngRange(program.gustPauseMin, program.gustPauseMax);
+                } else {
+                    gustActive = true;      // sharp gust: random peak for a random time
+                    gustPeak = (uint8_t)rngRange(program.gustMin, program.gustMax);
+                    gustEdgeMs = nowMs + rngRange(program.gustLenMin, program.gustLenMax);
+                }
+            }
+            writeOutputs(gustActive ? gustPeak : program.throttlePercent);
+        } else {
+            writeOutputs(program.throttlePercent);
+        }
+        break;
+    }
+
+    autostartDebug(nowMs, rxValidNow);
+}
+
+#endif // USE_AUTOSTART
