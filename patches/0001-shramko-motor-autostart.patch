+// Thousands of random sequences of a few minutes each, every setting inside its CLI range (edges included),
+// every input of the module randomized; invariants checked on every 20 ms tick. On a failure the
+// [ PROPERTY ] lines name the invariant, the seed, the sequence, the settings and the event log.
+TEST(AutostartPropertyTest, RandomSequencesKeepAllInvariants)
+{
+    setDefaults(AUTOSTART_MODE_POWER);
+    static const uint32_t seeds[] = { 0x5EED0001u, 0x5EED0002u, 0x0BADC0DEu, 0x12345678u, 0xA5A5A5A5u, 0x31415926u, 0x27182818u, 0xDEADBEEFu };
+    autostartprop::Results res;
+    autostartprop::runProperty(seeds, sizeof(seeds) / sizeof(seeds[0]), 220, res);
+    autostartprop::printResults(res);
+    // the generator must actually reach every corner, otherwise a pass means nothing
+    // (about 60 % of what a correct module reaches with these seeds)
+    EXPECT_GT(res.cover[autostartprop::C_RUN_REACHED], 600);
+    EXPECT_GT(res.cover[autostartprop::C_LOWBAT_REACHED], 200);
+    EXPECT_GT(res.cover[autostartprop::C_DONE_REACHED], 80);
+    EXPECT_GT(res.cover[autostartprop::C_GUSTS], 700);
+    EXPECT_GT(res.cover[autostartprop::C_START_POWER], 500);
+    EXPECT_GT(res.cover[autostartprop::C_START_BUTTON], 400);
+    EXPECT_GT(res.cover[autostartprop::C_START_RCBOX], 250);
+    EXPECT_GT(res.cover[autostartprop::C_CLEAN_CLICKS], 800);
+    EXPECT_GT(res.cover[autostartprop::C_CLI_SESSIONS], 400);
+    EXPECT_GT(res.cover[autostartprop::C_MSP_WRITES], 400);
+    EXPECT_GT(res.cover[autostartprop::C_FOREIGN_DETECTED], 20);
+    EXPECT_GT(res.cover[autostartprop::C_UNPLUGS], 1500);
+    EXPECT_GT(res.cover[autostartprop::C_WARP_2_31] + res.cover[autostartprop::C_WARP_2_32], 150);
+    EXPECT_GT(res.cover[autostartprop::C_TICKS_PAST_2_31], 100000);
+    EXPECT_GT(res.cover[autostartprop::C_TICKS_AFTER_WRAP], 100000);
+    // the checks added with the fixes of 2026-10-20 (counts with these seeds: 1808, 54072, 35, 4166, 1656, 1455)
+    EXPECT_GT(res.cover[autostartprop::C_USB_FAST_LOSS], 1000);
+    EXPECT_GT(res.cover[autostartprop::C_SAG_HYSTERESIS], 30000);
+    EXPECT_GT(res.cover[autostartprop::C_HOOK_STOPS], 20);
+#ifdef USE_DSHOT
+    EXPECT_GT(res.cover[autostartprop::C_BEACONS], 2500);
+    EXPECT_GT(res.cover[autostartprop::C_BEACON_RX_SKIPS], 1000);
+#ifdef USE_DSHOT_TELEMETRY
+    EXPECT_GT(res.cover[autostartprop::C_EDT_ASKED], 800);
+#endif
+#endif
+    EXPECT_EQ(0, res.total()) << "see the [ PROPERTY ] VIOLATION lines above";
+}
