+
+/*
+ * Shramko Motor Autostart (author: Andrii Shramko).
+ * Receiverless "blower" program: after boot (or a button click) wait
+ * autostart_delay seconds, ramp the selected motors linearly to
+ * autostart_throttle percent over autostart_ramp, then hold until power
+ * is removed. Output goes through motor_disarmed[], the same path the
+ * Configurator motor test (MSP_SET_MOTOR) uses, so DShot/PWM and the
+ * ESC stop-command-at-boot behaviour are unchanged.
+ */
+
+#pragma once
+
+#include <stdbool.h>
+
+#include "common/time.h"
+
+void autostartInit(void);
+void autostartUpdate(timeUs_t currentTimeUs);
+bool autostartIsEnabled(void);
+bool autostartIsDrivingMotors(void);
+bool autostartSuppressRxLostBeeper(void);
