+// writeOutputs() with the fakes' PWM-like motorConvertFromExternal()
+static float outputFor(float percent, int limit)
+{
+    const float pct = constrainf(percent, 0.0f, (float)limit);
+    const uint16_t external = 1000 + (uint16_t)lrintf(pct * (2000 - 1000) / 100.0f);
+    return external <= 1000 ? DISARM : (float)external;
+}
