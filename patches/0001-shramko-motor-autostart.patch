+
+// Shramko Motor Autostart - state machine tests (fc/autostart.c) with all hardware stubbed.
+
+#include <stdint.h>
+#include <stdbool.h>
+#include <string.h>
+
+extern "C" {
+    #include "platform.h"
+
+    #include "build/debug.h"
+
+    #include "common/filter.h"
+    #include "common/maths.h"
+    #include "common/time.h"
+
+    #include "config/feature.h"
+
+    #include "drivers/io.h"
+    #include "drivers/motor.h"
+
+    #include "fc/rc_modes.h"
+    #include "fc/runtime_config.h"
+
+    #include "flight/mixer.h"
+    #include "flight/mixer_init.h"
+
+    #include "msp/msp_box.h"
+
+    #include "pg/pg.h"
+    #include "pg/pg_ids.h"
+    #include "pg/autostart.h"
+
+    #include "fc/autostart.h"
+#ifdef USE_DSHOT
+    #include "drivers/dshot.h"
+    #include "drivers/dshot_command.h"
+    #include "pg/motor.h"
+#endif
+
+    #include "sensors/battery.h"
+
+    // ---- stubs / fakes ----
+    static timeMs_t fakeMs;
+    static bool fakePinHigh;        // pull-up: true = released
+    static bool fakePinFree;
+    static bool fakeRxValid;
+    static bool fakeUsb;
+    static boxId_e fakeActiveBox;
+    static uint32_t fakeFeatures;
+    static int beepCalls;
+    static int pinInitCount;
+    static uint8_t fakeIoRec;
+    static uint16_t fakeVbat;       // 0.01 V
+    static bool spikeFirstRead;     // a short EMI spike pulls the pin low exactly at the first read of every tick
+    static int tickReadIndex;
+
+    uint8_t armingFlags = 0;
+    uint8_t debugMode = DEBUG_NONE;
+    bool cliMode = false;
+    int16_t debug[DEBUG16_VALUE_COUNT];
+    float motor_disarmed[MAX_SUPPORTED_MOTORS];
+    mixerRuntime_t mixerRuntime;
+
+    timeMs_t millis(void) { return fakeMs; }
+    static timeUs_t fakeMicrosJitter;   // scheduler jitter of the 50 Hz task
+    timeUs_t micros(void) { return (timeUs_t)fakeMs * 1000 + fakeMicrosJitter; }
+    bool IORead(IO_t io) { UNUSED(io); const bool spike = spikeFirstRead && tickReadIndex == 0; tickReadIndex++; return spike ? false : fakePinHigh; }
+    IO_t IOGetByTag(ioTag_t tag) { return tag ? (IO_t)&fakeIoRec : IO_NONE; }
+    void IOInit(IO_t io, resourceOwner_e owner, uint8_t index) { UNUSED(io); UNUSED(owner); UNUSED(index); pinInitCount++; }
+    void IOConfigGPIO(IO_t io, ioConfig_t cfg) { UNUSED(io); UNUSED(cfg); }
+    bool IOIsFreeOrPreinit(IO_t io) { UNUSED(io); return fakePinFree; }
+    // PWM-like conversion (external us == motor value) so outputs can be checked directly
+    float motorConvertFromExternal(uint16_t externalValue) { return externalValue; }
+    uint8_t getMotorCount(void) { return 4; }
+    void beeperConfirmationBeeps(uint8_t beepCount) { UNUSED(beepCount); beepCalls++; }
+    bool rxAreFlightChannelsValid(void) { return fakeRxValid; }
+    bool usbCableIsInserted(void) { return fakeUsb; }
+    bool IS_RC_MODE_ACTIVE(boxId_e boxId) { return boxId == fakeActiveBox; }
+    bool featureIsEnabled(const uint32_t mask) { return (fakeFeatures & mask) != 0; }
+    bool isBatteryVoltageConfigured(void) { return true; }
+    uint16_t getBatteryVoltageLatest(void) { return fakeVbat; }
+    static uint16_t fakeVbatFiltered;  // 0 = same as the latest reading
+    uint16_t getBatteryVoltage(void) { return fakeVbatFiltered ? fakeVbatFiltered : fakeVbat; }
+    static uint8_t fakeCells;
+    uint8_t getBatteryCellCount(void) { return fakeCells; }
+    static int dshotBeacons;
+    bool isMotorProtocolDshot(void) { return true; }
+#ifdef USE_DSHOT
+    // model of the stock gate (drivers/dshot_command.c dshotStreamingCommandsAreEnabled()): inline commands are
+    // dropped silently until > 3000 ms after motorEnable() (end of init); once one passed, the gate stays open
+    static timeMs_t fakeMotorEnableMs;
+    static bool dshotFirstPassed;
+    static int edtRequests, edtAccepted;
+    bool dshotStreamingCommandsAreEnabled(void)
+    {
+        if (!dshotFirstPassed && (int32_t)(fakeMs - fakeMotorEnableMs) > 3000) {
+            dshotFirstPassed = true;
+        }
+        return dshotFirstPassed;
+    }
+    bool dshotCommandQueueEmpty(void) { return true; }
+    void dshotCommandWrite(uint8_t index, uint8_t motorCount, uint8_t command, dshotCommandType_e commandType)
+    {
+        UNUSED(index); UNUSED(motorCount);
+        const bool accepted = commandType != DSHOT_CMD_TYPE_INLINE || dshotStreamingCommandsAreEnabled();
+        if (command == DSHOT_CMD_BEACON3) {
+            dshotBeacons++;
+        }
+        if (command == DSHOT_CMD_EXTENDED_TELEMETRY_ENABLE) {
+            edtRequests++;
+            edtAccepted += accepted ? 1 : 0;
+        }
+    }
+#ifdef USE_DSHOT_TELEMETRY
+    bool useDshotTelemetry = true;
+    PG_REGISTER(motorConfig_t, motorConfig, PG_MOTOR_CONFIG, 3);
+#endif
+#endif
+
+    static const box_t testBoxes[] = {
+        { .boxName = "ARM",   .boxId = BOXARM,   .permanentId = 0 },
+        { .boxName = "USER3", .boxId = BOXUSER3, .permanentId = 42 },
+    };
+    const box_t *findBoxByPermanentId(uint8_t permanentId)
+    {
+        for (unsigned i = 0; i < sizeof(testBoxes) / sizeof(testBoxes[0]); i++) {
+            if (testBoxes[i].permanentId == permanentId) {
+                return &testBoxes[i];
+            }
+        }
+        return NULL;
+    }
+}
+
+#include "unittest_macros.h"
+#include "gtest/gtest.h"
+
+#define DISARM 1000.0f
+#define OTHER  1234.0f   // value a motor test left on motor 2; must never be touched
+
+static void setDefaults(autostartMode_e mode)
+{
+    autostartConfig_t *cfg = autostartConfigMutable();
+    cfg->mode = mode;
+    cfg->delaySeconds = 10;
+    cfg->rampDeciseconds = 100;
+    cfg->throttlePercent = 15;
+    cfg->motorMask = 0x01;
+    cfg->usbInhibit = 1;
+    cfg->rcBoxPermanentId = 255;
+    cfg->buttonTag = 0;
+    cfg->vbatMinDeciVolts = 60;     // 6.0 V
+    cfg->runTimeSeconds = 0;
+    cfg->throttleLimit = 100;
+    cfg->pattern = AUTOSTART_PATTERN_STEADY;
+    cfg->gustMinPercent = 40;
+    cfg->gustMaxPercent = 80;
+    cfg->gustLenMinMs = 300;
+    cfg->gustLenMaxMs = 800;
+    cfg->gustPauseMinDs = 20;
+    cfg->gustPauseMaxDs = 80;
+    cfg->cells = 6;
+    cfg->cellCutoffCv = 330;        // 3.30 V/cell -> 19.80 V on 6S
+    cfg->cutoffTimeSeconds = 5;
+    fakeCells = 0;
+    dshotBeacons = 0;
+    fakeMicrosJitter = 0;
+#ifdef USE_DSHOT
+    fakeMotorEnableMs = 1500;   // motorEnable() at the end of init, just before autostartInit()
+    dshotFirstPassed = false;
+    edtRequests = edtAccepted = 0;
+#ifdef USE_DSHOT_TELEMETRY
+    motorConfigMutable()->dev.useDshotEdt = 0;
+#endif
+#endif
+
+    fakeMs = 1500;          // init finishes ~1.5 s after power-on
+    fakePinHigh = true;
+    fakePinFree = true;
+    fakeRxValid = false;
+    fakeUsb = false;
+    fakeActiveBox = (boxId_e)BOXID_NONE;
+    fakeFeatures = 0;
+    fakeVbat = 2500;        // 6S battery present from power-on (battery-only use)
+    fakeVbatFiltered = 0;
+    spikeFirstRead = false;
+    tickReadIndex = 0;
+    cliMode = false;
+    beepCalls = 0;
+    pinInitCount = 0;
+    armingFlags = 0;
+    debugMode = DEBUG_NONE;
+    memset(debug, 0, sizeof(debug));
+    mixerRuntime.disarmMotorOutput = DISARM;
+    for (int i = 0; i < MAX_SUPPORTED_MOTORS; i++) {
+        motor_disarmed[i] = DISARM;
+    }
+    motor_disarmed[1] = OTHER;
+}
