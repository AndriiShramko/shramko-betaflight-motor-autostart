+/*
+ * Shramko Motor Autostart - configuration (parameter group).
+ * Author: Andrii Shramko. Drives selected motor outputs through the
+ * disarmed "motor test" path (motor_disarmed[]) without a receiver.
+ */
+
+#pragma once
+
+#include <stdint.h>
+
+#include "drivers/io_types.h"
+
+#include "pg/pg.h"
+
+typedef enum {
+    AUTOSTART_MODE_OFF = 0,     // feature disabled (stock Betaflight behaviour)
+    AUTOSTART_MODE_POWER,       // program starts automatically after boot
+    AUTOSTART_MODE_BUTTON,      // program starts on a button click
+    AUTOSTART_MODE_COUNT
+} autostartMode_e;
+
+typedef enum {
+    AUTOSTART_PATTERN_STEADY = 0,   // ramp to the throttle and hold it
+    AUTOSTART_PATTERN_GUSTS,        // hold the throttle, with random sharp gusts on top
+    AUTOSTART_PATTERN_COUNT
+} autostartPattern_e;
+
+typedef struct autostartConfig_s {
+    uint8_t mode;               // autostartMode_e
+    uint16_t delaySeconds;      // delay after boot / click before the ramp starts, 0..600 s
+    uint16_t rampDeciseconds;   // ramp time 0 -> target, 0.1 s units, 0..6000 (0..600 s)
+    uint8_t throttlePercent;    // target, % of the motor-test range (1000..2000 us external), 0..100
+    uint8_t motorMask;          // bit0 = motor 1, bit1 = motor 2, ...
+    uint8_t usbInhibit;         // 1 = never drive while a USB host has configured the VCP
+    uint8_t rcBoxPermanentId;   // BOXUSER1..4 permanent id (40..43) that runs the program while the RX link is valid, 255 = none
+    ioTag_t buttonTag;          // resource AUTOSTART 1 <pin>; button between pin and GND, internal pull-up
+    uint16_t vbatMinDeciVolts;  // battery counts as plugged in at or above this voltage, 0.1 V units; 0 = don't check
+    // firmware 1.1 (appended: an older stored config keeps its values, these get their defaults)
+    uint16_t runTimeSeconds;    // run time after the ramp, 0 = until the cut-off / power off
+    uint16_t gustLenMinMs;      // gust length range, ms
+    uint16_t gustLenMaxMs;
+    uint16_t gustPauseMinDs;    // pause between gusts, 0.1 s
+    uint16_t gustPauseMaxDs;
+    uint16_t cellCutoffCv;      // battery cut-off per cell, 0.01 V; 0 = off
+    uint8_t throttleLimit;      // hard cap for every output of the program, %
+    uint8_t pattern;            // autostartPattern_e
+    uint8_t gustMinPercent;     // gust peak range, %
+    uint8_t gustMaxPercent;
+    uint8_t cells;              // battery cell count, 0 = Betaflight auto-detection
+    uint8_t cutoffTimeSeconds;  // the voltage must stay below the cut-off this long
+} autostartConfig_t;
+
+PG_DECLARE(autostartConfig_t, autostartConfig);
